        <mxCell id="p1-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-cards" target="p1-boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
