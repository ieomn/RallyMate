  <diagram id="rallymate-inference-gates-v1" name="03 推理测量与评分门禁">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="推理、测量与评分是三层：有 Pose ≠ 有可靠测量 ≠ 可正式评分" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102A43;strokeColor=#102A43;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1520" height="60" as="geometry"/></mxCell>
