  <diagram id="rallymate-api-state-v1" name="02 服务 API 与作业状态">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p2-title" value="FastAPI v1.2.0：9 个显式业务路由、可选 Bearer、SQLite 状态机" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102A43;strokeColor=#102A43;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1520" height="60" as="geometry"/></mxCell>
        <mxCell id="p2-client" value="调用方&lt;br&gt;浏览器 / CLI / 运维探针" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F99D;strokeColor=#0B6E4F;fontColor=#102A43;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="145" width="190" height="95" as="geometry"/></mxCell>
        <mxCell id="p2-public" value="始终公开&lt;br&gt;GET /health/live&lt;br&gt;GET /&lt;br&gt;/assets/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#102A43;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="p2-auth" value="可选 Bearer 门禁&lt;br&gt;RALLYMATE_API_KEY 未设：放行&lt;br&gt;已设：Authorization 精确匹配&lt;br&gt;失败：401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="285" width="250" height="135" as="geometry"/></mxCell>
        <mxCell id="p2-ready" value="GET /health/ready&lt;br&gt;200 + ready/not_ready&lt;br&gt;模型 / registry / 标定依赖 / 队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#102A43;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="115" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-cap" value="GET /v1/model-capabilities&lt;br&gt;298 项静态矩阵&lt;br&gt;13 项最小测量闭环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#102A43;fontSize=13;" vertex="1" parent="1"><mxGeometry x="945" y="115" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-list" value="GET /v1/jobs&lt;br&gt;limit 默认 20，钳制 1～100&lt;br&gt;created_at 倒序" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#102A43;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="115" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-submit" value="POST /v1/jobs&lt;br&gt;multipart 上传&lt;br&gt;202 + 公共 job 对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="270" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-get" value="GET /v1/jobs/{job_id}&lt;br&gt;状态 / 进度 / summary&lt;br&gt;成功时产物 URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#102A43;fontSize=13;" vertex="1" parent="1"><mxGeometry x="945" y="270" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-demo" value="GET /v1/jobs/{job_id}/demo-result&lt;br&gt;仅 succeeded&lt;br&gt;真实测量 → 用户结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F99D;strokeColor=#0B6E4F;fontColor=#102A43;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="270" width="245" height="105" as="geometry"/></mxCell>
        <mxCell id="p2-artifact" value="GET /v1/jobs/{job_id}/artifacts/{name}&lt;br&gt;仅 succeeded + 18 项精确白名单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#102A43;fontSize=13;" vertex="1" parent="1"><mxGeometry x="945" y="425" width="365" height="90" as="geometry"/></mxCell>
        <mxCell id="p2-auto" value="FastAPI 自动路由（不计入 9 个）&lt;br&gt;/docs · /redoc · /openapi.json&lt;br&gt;当前无额外全局鉴权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1335" y="425" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="p2-db" value="jobs.sqlite3&lt;br&gt;WAL + 状态 CHECK&lt;br&gt;进度/summary JSON" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="560" width="180" height="145" as="geometry"/></mxCell>
        <mxCell id="p2-queued" value="queued&lt;br&gt;attempts=0…" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#102A43;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="570" width="155" height="85" as="geometry"/></mxCell>
        <mxCell id="p2-running" value="running&lt;br&gt;worker_id + lease" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#102A43;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="570" width="175" height="85" as="geometry"/></mxCell>
        <mxCell id="p2-succeeded" value="succeeded&lt;br&gt;summary + 100%" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#102A43;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="535" width="175" height="85" as="geometry"/></mxCell>
        <mxCell id="p2-failed" value="failed&lt;br&gt;error + completed_at" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="685" width="175" height="85" as="geometry"/></mxCell>
        <mxCell id="p2-retry" value="lease 过期&lt;br&gt;attempts &lt; max_attempts：回队列&lt;br&gt;否则失败（默认最多 2 次）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="735" width="255" height="95" as="geometry"/></mxCell>
        <mxCell id="p2-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-client" target="p2-public"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-client" target="p2-auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-auth" target="p2-ready"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-auth" target="p2-cap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-auth" target="p2-list"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-auth" target="p2-submit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-auth" target="p2-get"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0B6E4F;endArrow=block;endFill=1;" edge="1" parent="1" source="p2-auth" target="p2-demo"><mxGeometry relative="1" as="geometry"/></mxCell>
