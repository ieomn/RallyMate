        <mxCell id="p5-base" value="当前默认基线&lt;br&gt;rtmpose-m-halpe26-online&lt;br&gt;M / 256×192 / Halpe26&lt;br&gt;F2 measurement default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F99D;strokeColor=#0B6E4F;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="235" height="130" as="geometry"/></mxCell>
        <mxCell id="p5-m384" value="候选 A&lt;br&gt;RTMPose-M Halpe26&lt;br&gt;384×288 analysis preset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#102A43;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="105" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="p5-l384" value="候选 B&lt;br&gt;RTMPose-L Halpe26 384×288&lt;br&gt;M71 operational 2333 / 2366&lt;br&gt;仍未真人准确率验证" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#102A43;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="p5-whole" value="候选 C&lt;br&gt;RTMPose-M WholeBody133&lt;br&gt;256×192 analysis preset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#102A43;fontSize=14;" vertex="1" parent="1"><mxGeometry x="350" y="345" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="p5-x384" value="候选 D：RTMPose-X 384×288&lt;br&gt;M96 同帧置信覆盖 0.769231&lt;br&gt;realtime/no-flip P50 11.7265 ms&lt;br&gt;覆盖与速度都不是准确率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#102A43;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="460" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="p5-controlled" value="两种固定比较&lt;br&gt;M96：45 同帧同 ROI，realtime/no-flip&lt;br&gt;M97：258 残差帧，analysis+flip&lt;br&gt;跨范围延迟不得算比值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="175" width="250" height="135" as="geometry"/></mxCell>
        <mxCell id="p5-m71" value="L384 下游证据&lt;br&gt;M71：258 个残差帧&lt;br&gt;feature 2344 / operational 2333&lt;br&gt;相对 M68 恢复 13，回归 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#102A43;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="105" width="245" height="125" as="geometry"/></mxCell>
        <mxCell id="p5-m95-smoke" value="M97 X 下游证据&lt;br&gt;feature 2342 / operational 2331&lt;br&gt;相对 M70：+4 / lost 0&lt;br&gt;相对 M71：+1 / lost 3（净 -2）&lt;br&gt;holdout 未打开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#9333EA;fontColor=#102A43;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="255" width="245" height="145" as="geometry"/></mxCell>
        <mxCell id="p5-notaccuracy" value="不能据此晋级&lt;br&gt;置信覆盖 / operational 恢复 ≠ 准确率&lt;br&gt;X 未保持 M71 恢复集合&lt;br&gt;未做真人 MAE / P95 / PCK&lt;br&gt;默认 M256 保持不变" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1280" y="160" width="250" height="175" as="geometry"/></mxCell>
        <mxCell id="p5-truth" value="M96 Halpe26 评测试点&lt;br&gt;3 视频 × 8 帧 × 26 点 = 624&lt;br&gt;A/B 空白角色包；C 只接分歧&lt;br&gt;人工行 0；evaluation_only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#102A43;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="445" width="270" height="135" as="geometry"/></mxCell>
        <mxCell id="p5-metrics" value="预注册评价&lt;br&gt;必需关节 MAE / P95 / PCK&lt;br&gt;事件 F1 / phase error&lt;br&gt;下游特征误差与缺失&lt;br&gt;速度 / 显存 / 失败率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#102A43;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="420" width="270" height="165" as="geometry"/></mxCell>
        <mxCell id="p5-decision" value="候选是否满足门禁？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="430" width="190" height="145" as="geometry"/></mxCell>
        <mxCell id="p5-finetune" value="真值就绪后：网球域微调&lt;br&gt;严格审计 → COCO/Halpe26 导出&lt;br&gt;train 自身具备 26 点可见监督&lt;br&gt;视频/path/SHA/运动员/session 隔离&lt;br&gt;holdout 三重拒绝；Runner 仅门禁后启动&lt;br&gt;当前未训练 / 未产生新权重" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#102A43;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="655" width="310" height="175" as="geometry"/></mxCell>
        <mxCell id="p5-independent" value="独立视频发布验证&lt;br&gt;不参与模型/阈值选择&lt;br&gt;同时检查精度、稳定性、成本&lt;br&gt;失败则保持候选" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1035" y="675" width="270" height="135" as="geometry"/></mxCell>
        <mxCell id="p5-promote" value="通过后才发布&lt;br&gt;登记已验证版本化 preset&lt;br&gt;显式切换默认 + 保留回滚&lt;br&gt;记录 checkpoint/config/SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="665" width="200" height="145" as="geometry"/></mxCell>
        <mxCell id="p5-separate" value="独立的评分晋级链&lt;br&gt;Pose preset 通过 ≠ F4&lt;br&gt;仍需 event/keypoint/coach truth、标定、sealed test、可信账本与 runtime binding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="p5-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-base" target="p5-m384"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-base" target="p5-l384"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-base" target="p5-whole"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e3x" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9333EA;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-base" target="p5-x384"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-m384" target="p5-controlled"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-l384" target="p5-controlled"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-whole" target="p5-controlled"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-controlled" target="p5-m71"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-m71" target="p5-notaccuracy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e8x" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9333EA;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-x384" target="p5-m95-smoke"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e8y" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-m95-smoke" target="p5-notaccuracy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-controlled" target="p5-truth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-truth" target="p5-metrics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-metrics" target="p5-decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-decision" target="p5-finetune"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e13" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-decision" target="p5-independent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e14" value="重新评价" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;dashed=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-finetune" target="p5-metrics"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e15" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p5-independent" target="p5-promote"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5-e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;dashed=1;endArrow=none;" edge="1" parent="1" source="p5-promote" target="p5-separate"><mxGeometry relative="1" as="geometry"/></mxCell>
