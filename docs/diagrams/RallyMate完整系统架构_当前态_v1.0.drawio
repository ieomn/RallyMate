  <diagram id="rallymate-user-flow-v1" name="01 用户上传到结果">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1-title" value="RallyMate 当前用户链：上传真实视频 → 异步分析 → 可解释结果" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102A43;strokeColor=#102A43;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=left;spacingLeft=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1520" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p1-user" value="用户&lt;br&gt;选择或拖入视频&lt;br&gt;标注视频默认关闭" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F99D;strokeColor=#0B6E4F;fontColor=#102A43;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="180" width="170" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-page" value="GET / · ?job_id 恢复&lt;br&gt;用户演示页 v1.2&lt;br&gt;/assets/*?v=1.2.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#102A43;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="270" y="180" width="175" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-post" value="POST /v1/jobs&lt;br&gt;multipart/form-data&lt;br&gt;202 + id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#102A43;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="495" y="180" width="180" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-validate" value="API 入口校验&lt;br&gt;扩展名 / 大小 / 时长&lt;br&gt;解码 / 表单范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#102A43;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="725" y="180" width="185" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-queue" value="持久化入口&lt;br&gt;uploads + requests&lt;br&gt;SQLite: queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#102A43;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="960" y="180" width="180" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-worker" value="Persistent Worker&lt;br&gt;GPU RTMPose 优先&lt;br&gt;CPU 回退默认 4 线程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="180" width="180" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-pipeline" value="真实视频分析链&lt;br&gt;Detect + RTMPose&lt;br&gt;Track → Event → Feature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#0B6E4F;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1410" y="180" width="150" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-poll" value="页面轮询&lt;br&gt;GET /v1/jobs/{id}&lt;br&gt;queued / running" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#64748B;fontColor=#102A43;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="270" y="390" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p1-success" value="成功任务&lt;br&gt;succeeded + summary&lt;br&gt;实际 artifact_urls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#102A43;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="560" y="390" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p1-demo" value="GET /v1/jobs/{id}/demo-result&lt;br&gt;读取 summary + indicator-features&lt;br&gt;只读适配，不改推理产物" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#102A43;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="380" width="270" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p1-cards" value="用户可读结果 v1.2&lt;br&gt;动作表现参考分（Beta）&lt;br&gt;严格 13 项自然语言观察 / 建议&lt;br&gt;null → 暂无法评价 · GPU/CPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9F99D;strokeColor=#0B6E4F;fontColor=#102A43;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="370" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="p1-artifacts" value="可追溯产物&lt;br&gt;骨架视频按需生成&lt;br&gt;API 仍为 18 项白名单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#102A43;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1210" y="570" width="250" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-fail" value="失败分支&lt;br&gt;后端保留 failed + error&lt;br&gt;用户页只显示友好中文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="700" y="600" width="260" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-boundary" value="诚实边界&lt;br&gt;Beta ≠ 准确率 / 正式教练标定分&lt;br&gt;13 项仍为 F2；正式分 / A～E = null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="740" width="430" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p1-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0B6E4F;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-user" target="p1-page"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-page" target="p1-post"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-post" target="p1-validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-validate" target="p1-queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-queue" target="p1-worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0B6E4F;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-worker" target="p1-pipeline"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e7" value="状态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-queue" target="p1-poll"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-pipeline" target="p1-success"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-success" target="p1-demo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0B6E4F;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-demo" target="p1-cards"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0284C7;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-success" target="p1-artifacts"><mxGeometry relative="1" as="geometry"/></mxCell>
