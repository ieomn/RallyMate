{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/scoring-truth-calibration-acceptance-ledger.schema.json",
  "title": "Externally pinned calibration input acceptance; never production-scoring permission",
  "type": "object",
  "required": [
    "ledger_version",
    "ledger_id",
    "authority_id",
    "registered_at",
    "entries"
  ],
  "properties": {
    "ledger_version": {
      "const": "scoring-truth-calibration-acceptance-ledger-v1.0.0"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_id": {
      "type": "string",
      "minLength": 1
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "authorization_id",
          "status",
          "scope",
          "current_revision_id",
          "event_intake_manifest_sha256",
          "binding",
          "approvals",
          "attestations",
          "promotion_authorized",
          "production_scoring_authorized"
        ],
        "properties": {
          "authorization_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "active",
              "revoked"
            ]
          },
          "scope": {
            "const": "calibration_input_only"
          },
          "current_revision_id": {
            "type": "string",
            "minLength": 1
          },
          "event_intake_manifest_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "binding": {
            "title": "RallyMate content-bound scoring-truth calibration authorization lineage",
            "type": "object",
            "required": [
              "binding_version",
              "status",
              "canonicalization",
              "authorization_id",
              "event_protocol_authorization",
              "intake",
              "revision_lineage",
              "input_files",
              "binding_sha256"
            ],
            "properties": {
              "binding_version": {
                "const": "scoring-truth-calibration-authorization-binding-v1.0.0"
              },
              "status": {
                "const": "verified_authorized_intake_for_calibration"
              },
              "canonicalization": {
                "const": "rallymate-canonical-json-v1"
              },
              "authorization_id": {
                "type": "string",
                "minLength": 1
              },
              "event_protocol_authorization": {
                "$ref": "#/$defs/event_authorization"
              },
              "intake": {
                "type": "object",
                "required": [
                  "intake_id",
                  "intake_version",
                  "content_root_sha256"
                ],
                "properties": {
                  "intake_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intake_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "content_root_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}$"
                  }
                },
                "additionalProperties": false
              },
              "revision_lineage": {
                "type": "object",
                "required": [
                  "revision_id",
                  "annotator_a_id",
                  "annotator_b_id",
                  "reviewer_c_id",
                  "annotator_a_export_root_sha256",
                  "annotator_b_export_root_sha256",
                  "reviewer_c_adjudication_root_sha256",
                  "roles_distinct",
                  "revision_finalized"
                ],
                "properties": {
                  "revision_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "annotator_a_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "annotator_b_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewer_c_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "annotator_a_export_root_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "annotator_b_export_root_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "reviewer_c_adjudication_root_sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "roles_distinct": {
                    "type": "boolean"
                  },
                  "revision_finalized": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "input_files": {
                "type": "object",
                "required": [
                  "intake_manifest",
                  "truth_manifest",
                  "truth_validation_report",
                  "manual_events",
                  "manual_semantics",
                  "coach_labels"
                ],
                "properties": {
                  "intake_manifest": {
                    "$ref": "#/$defs/sha256"
                  },
                  "truth_manifest": {
                    "$ref": "#/$defs/sha256"
                  },
                  "truth_validation_report": {
                    "$ref": "#/$defs/sha256"
                  },
                  "manual_events": {
                    "$ref": "#/$defs/sha256"
                  },
                  "manual_semantics": {
                    "$ref": "#/$defs/sha256"
                  },
                  "coach_labels": {
                    "$ref": "#/$defs/sha256"
                  }
                },
                "additionalProperties": false
              },
              "binding_sha256": {
                "$ref": "#/$defs/sha256"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "verified_authorized_intake_for_calibration"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "revision_lineage": {
                      "properties": {
                        "roles_distinct": {
                          "const": true
                        },
                        "revision_finalized": {
                          "const": true
                        }
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "unverified_private_truth_diagnostic",
                        "synthetic_test_only_no_production_authority"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "revision_lineage": {
                      "properties": {
                        "roles_distinct": {
                          "const": false
                        },
                        "revision_finalized": {
                          "const": false
                        }
                      }
                    }
                  }
                }
              }
            ],
            "additionalProperties": false
          },
          "approvals": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "reviewer_id",
                "role",
                "approved_at",
                "external_record_sha256"
              ],
              "properties": {
                "reviewer_id": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "truth_data_reviewer",
                    "calibration_release_operator"
                  ]
                },
                "approved_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "external_record_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "additionalProperties": false
            }
          },
          "attestations": {
            "type": "object",
            "required": [
              "independent_collection_reviewed",
              "raw_source_provenance_reviewed",
              "semantic_adjudication_reviewed",
              "raw_coach_labels_reviewed",
              "projection_defaults_not_observed_truth"
            ],
            "properties": {
              "independent_collection_reviewed": {
                "const": true
              },
              "raw_source_provenance_reviewed": {
                "const": true
              },
              "semantic_adjudication_reviewed": {
                "const": true
              },
              "raw_coach_labels_reviewed": {
                "const": true
              },
              "projection_defaults_not_observed_truth": {
                "const": true
              }
            },
            "additionalProperties": false
          },
          "promotion_authorized": {
            "const": false
          },
          "production_scoring_authorized": {
            "const": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?Z$"
    },
    "event_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_version",
        "status",
        "canonicalization",
        "plan",
        "release_record",
        "technical_handoff",
        "scope_digest_sha256",
        "role_protocol_digest_sha256",
        "operator_release_record_verified",
        "annotation_workflow_release_only",
        "binding_sha256"
      ],
      "properties": {
        "binding_version": {
          "const": "scoring-truth-event-authorization-binding-v2.0.0"
        },
        "status": {
          "const": "operator_reviewed_local_release_verified"
        },
        "canonicalization": {
          "const": "rallymate-canonical-json-v1"
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan_id",
            "plan_version",
            "raw_sha256"
          ],
          "properties": {
            "plan_id": {
              "$ref": "#/$defs/identifier"
            },
            "plan_version": {
              "const": "scoring-truth-event-annotation-plan-v2.0.0"
            },
            "raw_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "release_record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release_id",
            "release_version",
            "raw_sha256",
            "released_at",
            "reviewer_id",
            "reviewer_role",
            "decision"
          ],
          "properties": {
            "release_id": {
              "$ref": "#/$defs/identifier"
            },
            "release_version": {
              "const": "scoring-truth-operator-reviewed-local-release-v1.0.0"
            },
            "raw_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "released_at": {
              "$ref": "#/$defs/timestamp"
            },
            "reviewer_id": {
              "$ref": "#/$defs/identifier"
            },
            "reviewer_role": {
              "const": "annotation_release_operator"
            },
            "decision": {
              "const": "operator_released_for_independent_event_phase_annotation"
            }
          }
        },
        "technical_handoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest_raw_sha256",
            "bundle_version",
            "bundle_id",
            "content_root_sha256",
            "source_projection_sha256"
          ],
          "properties": {
            "manifest_raw_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bundle_version": {
              "const": "scoring-truth-event-handoff-v1.0.0"
            },
            "bundle_id": {
              "type": "string",
              "pattern": "^m89-scoring-truth-event-[0-9A-F]{64}$"
            },
            "content_root_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "source_projection_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "scope_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role_protocol_digest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "operator_release_record_verified": {
          "const": true
        },
        "annotation_workflow_release_only": {
          "const": true
        },
        "binding_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
