{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/event-gap-keypoint-truth-pack.schema.json",
  "type": "object",
  "required": ["schema_version", "pack_version", "generated_at", "status", "sources", "scope", "workbench", "task_contract_sha256", "prediction_contract_sha256", "artifacts", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pack_version": {"const": "event-gap-keypoint-truth-pack-v1.0.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"const": "annotation_required"},
    "sources": {
      "type": "object",
      "required": ["m74_report", "per_video"],
      "properties": {
        "m74_report": {"$ref": "#/$defs/source"},
        "per_video": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["video_id", "view_group", "video", "m73_report", "frames", "primary_timeline", "events"],
            "properties": {
              "video_id": {"type": "string", "minLength": 1},
              "view_group": {"type": "string", "minLength": 1},
              "video": {"$ref": "#/$defs/source"},
              "m73_report": {"$ref": "#/$defs/source"},
              "frames": {"$ref": "#/$defs/source"},
              "primary_timeline": {"$ref": "#/$defs/source"},
              "events": {"$ref": "#/$defs/source"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["video_count", "video_ids", "view_groups", "frame_count", "joint_task_count", "joint_names", "event_codes", "indicator_ids", "required_independent_annotators", "required_independent_reviewer", "prediction_confidence_is_not_model_confidence"],
      "properties": {
        "video_count": {"const": 2},
        "video_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "view_groups": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "frame_count": {"const": 54},
        "joint_task_count": {"const": 142},
        "joint_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "event_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["FS01", "FS02", "FS09"]}},
        "indicator_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FS[0-9]{2}-M[0-9]{2}$"}},
        "required_independent_annotators": {"const": 2},
        "required_independent_reviewer": {"const": 1},
        "prediction_confidence_is_not_model_confidence": {"const": true}
      },
      "additionalProperties": false
    },
    "workbench": {
      "type": "object",
      "required": ["entry", "annotation_csv", "adjudication_csv", "compiled_keypoints", "validation_report", "sealed_predictions_not_loaded_by_ui"],
      "properties": {
        "entry": {"const": "review.html"},
        "annotation_csv": {"const": "annotations.csv"},
        "adjudication_csv": {"const": "adjudications.csv"},
        "compiled_keypoints": {"const": "compiled/manual-keypoints.jsonl"},
        "validation_report": {"const": "compiled/validation-report.json"},
        "sealed_predictions_not_loaded_by_ui": {"const": true}
      },
      "additionalProperties": false
    },
    "task_contract_sha256": {"$ref": "#/$defs/sha256"},
    "prediction_contract_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {"type": "object", "minProperties": 5, "additionalProperties": {"$ref": "#/$defs/source"}},
    "safety": {
      "type": "object",
      "required": ["prediction_coordinates_embedded_in_annotation_ui", "truth_prefilled_from_prediction", "model_values_used_as_truth", "independent_adjudication_required", "accuracy_claim", "partial_annotations_change_runtime", "production_enabled", "grade_generated", "threshold_generated", "maturity_promoted"],
      "properties": {
        "prediction_coordinates_embedded_in_annotation_ui": {"const": false},
        "truth_prefilled_from_prediction": {"const": false},
        "model_values_used_as_truth": {"const": false},
        "independent_adjudication_required": {"const": true},
        "accuracy_claim": {"const": false},
        "partial_annotations_change_runtime": {"const": false},
        "production_enabled": {"const": false},
        "grade_generated": {"const": false},
        "threshold_generated": {"const": false},
        "maturity_promoted": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "source": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
