{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/additive-keypoint-fusion.schema.json",
  "title": "RallyMate same-topology additive keypoint fusion experiment",
  "type": "object",
  "required": ["schema_version", "report_version", "generated_at", "status", "video_id", "sources", "artifacts", "fusion_audit", "comparison_to_m68", "m71_preservation", "decision", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_version": {"const": "same-topology-additive-keypoint-fusion-v1.0.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["experimental_additive_keypoint_fusion_regression_free_requires_truth", "experimental_additive_keypoint_fusion_rejected"]},
    "video_id": {"type": "string", "minLength": 1},
    "sources": {"type": "object"},
    "artifacts": {"type": "object"},
    "fusion_audit": {
      "type": "object",
      "required": ["fusion_version", "selection_policy", "confidence_min", "allowed_joint_names", "target_frame_count", "changed_frame_count", "unchanged_target_frame_count", "added_valid_joint_observation_count", "added_valid_joint_counts", "decision_reason_counts", "baseline_valid_joint_observations_preserved", "baseline_valid_coordinates_overwritten", "non_target_frames_preserved", "non_pose_frame_data_preserved", "non_selected_poses_preserved", "same_topology_required", "selection_uses_feature_values", "selection_uses_event_outcomes", "selection_uses_grades_or_thresholds"],
      "properties": {
        "fusion_version": {"const": "same-topology-missing-keypoint-addition-v1.0.0"},
        "baseline_valid_coordinates_overwritten": {"const": 0},
        "non_target_frames_preserved": {"const": true},
        "non_pose_frame_data_preserved": {"const": true},
        "non_selected_poses_preserved": {"const": true},
        "same_topology_required": {"const": true},
        "selection_uses_feature_values": {"const": false},
        "selection_uses_event_outcomes": {"const": false},
        "selection_uses_grades_or_thresholds": {"const": false}
      }
    },
    "comparison_to_m68": {"type": "object"},
    "m71_preservation": {
      "type": "object",
      "required": ["m71_feature_recovery_count", "fused_feature_recovery_count", "additional_feature_recovery_count", "lost_m71_feature_recovery_count", "m71_operational_recovery_count", "fused_operational_recovery_count", "additional_operational_recovery_count", "lost_m71_operational_recovery_count", "additional_operational_recoveries"]
    },
    "decision": {
      "type": "object",
      "required": ["production_default_changed", "candidate_promoted", "current_video_regression_free", "next_required_evidence"],
      "properties": {"production_default_changed": {"const": false}, "candidate_promoted": {"const": false}}
    },
    "safety": {
      "type": "object",
      "required": ["accuracy_claim", "ground_truth_provided", "production_enabled", "automatic_fallback_enabled", "feature_gate_modified", "measurement_gate_modified", "event_boundaries_modified", "grades_generated", "thresholds_generated", "maturity_promoted"],
      "properties": {
        "accuracy_claim": {"const": false}, "ground_truth_provided": {"const": false}, "production_enabled": {"const": false}, "automatic_fallback_enabled": {"const": false}, "feature_gate_modified": {"const": false}, "measurement_gate_modified": {"const": false}, "event_boundaries_modified": {"const": false}, "grades_generated": {"const": false}, "thresholds_generated": {"const": false}, "maturity_promoted": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
