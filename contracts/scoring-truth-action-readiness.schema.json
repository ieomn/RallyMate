{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/scoring-truth-action-readiness.schema.json",
  "title": "RallyMate scoring truth action evidence readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "readiness_version", "generated_at", "status", "source", "counts", "items", "indicator_instances", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "readiness_version": {"const": "scoring-truth-action-readiness-v1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["annotation_required", "review_in_progress", "evidence_satisfied_pending_scoring_recompute"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_id", "worklist", "truth_validation", "manual_events", "manual_keypoints", "manual_semantics", "scoring_truth_evaluation", "pose_truth_manifest", "pose_truth_evaluation", "scoring_reference_context", "event_matching"],
      "properties": {
        "video_id": {"type": "string", "minLength": 1},
        "worklist": {"$ref": "#/$defs/source"},
        "truth_validation": {"$ref": "#/$defs/source"},
        "manual_events": {"$ref": "#/$defs/source"},
        "manual_keypoints": {"$ref": "#/$defs/source"},
        "manual_semantics": {"$ref": "#/$defs/source"},
        "scoring_truth_evaluation": {"$ref": "#/$defs/source"},
        "pose_truth_manifest": {"$ref": "#/$defs/source"},
        "pose_truth_evaluation": {"$ref": "#/$defs/source"},
        "scoring_reference_context": {"$ref": "#/$defs/source"},
        "event_matching": {"type": "object"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_items", "by_status", "indicator_instances", "indicator_instances_by_status", "instance_action_links", "matched_manual_events", "accepted_manual_events", "accepted_manual_keypoint_frames", "accepted_manual_semantics", "pose_full_timeline_diagnostic_types", "accepted_target_direction_observations", "by_review_type", "by_truth_requirement"],
      "properties": {
        "work_items": {"type": "integer", "minimum": 1},
        "by_status": {"$ref": "#/$defs/statusCounts"},
        "indicator_instances": {"type": "integer", "minimum": 1},
        "indicator_instances_by_status": {"$ref": "#/$defs/statusCounts"},
        "instance_action_links": {"type": "integer", "minimum": 1},
        "matched_manual_events": {"type": "integer", "minimum": 0},
        "accepted_manual_events": {"type": "integer", "minimum": 0},
        "accepted_manual_keypoint_frames": {"type": "integer", "minimum": 0},
        "accepted_manual_semantics": {"type": "integer", "minimum": 0},
        "pose_full_timeline_diagnostic_types": {"type": "integer", "minimum": 0, "maximum": 4},
        "accepted_target_direction_observations": {"type": "integer", "minimum": 0},
        "by_review_type": {"$ref": "#/$defs/groupCounts"},
        "by_truth_requirement": {"$ref": "#/$defs/groupCounts"}
      }
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "indicator_instances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instance"}},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_item_completion_is_score_recompute", "quality_gate_modified", "scoring_state_modified", "grades_generated", "thresholds_generated", "maturity_promoted", "candidate_events_are_truth", "partial_review_is_adjudicated_truth", "coverage_is_accuracy", "maximum_status_without_calibration"],
      "properties": {
        "work_item_completion_is_score_recompute": {"const": false},
        "quality_gate_modified": {"const": false},
        "scoring_state_modified": {"const": false},
        "grades_generated": {"const": false},
        "thresholds_generated": {"const": false},
        "maturity_promoted": {"const": false},
        "candidate_events_are_truth": {"const": false},
        "partial_review_is_adjudicated_truth": {"const": false},
        "coverage_is_accuracy": {"const": false},
        "maximum_status_without_calibration": {"const": "calibration_required"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "status": {"enum": ["evidence_satisfied", "review_in_progress_not_adjudicated", "annotation_required"]},
    "statusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_satisfied", "review_in_progress_not_adjudicated", "annotation_required"],
      "properties": {
        "evidence_satisfied": {"type": "integer", "minimum": 0},
        "review_in_progress_not_adjudicated": {"type": "integer", "minimum": 0},
        "annotation_required": {"type": "integer", "minimum": 0}
      }
    },
    "groupCounts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["total", "evidence_satisfied", "review_in_progress_not_adjudicated", "annotation_required"],
        "properties": {
          "total": {"type": "integer", "minimum": 1},
          "evidence_satisfied": {"type": "integer", "minimum": 0},
          "review_in_progress_not_adjudicated": {"type": "integer", "minimum": 0},
          "annotation_required": {"type": "integer", "minimum": 0}
        }
      }
    },
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence": {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_item_id", "priority_rank", "event_id", "event_code", "review_type", "truth_requirement", "status", "evidence_outcome", "matched_manual_event_id", "segment_iou", "evidence", "missing_evidence", "affected_indicator_instances"],
      "properties": {
        "work_item_id": {"type": "string", "pattern": "^staw-[a-f0-9]{16}$"},
        "priority_rank": {"type": "integer", "minimum": 1},
        "event_id": {"type": "string", "minLength": 1},
        "event_code": {"enum": ["FS01", "FS02", "FS09"]},
        "review_type": {"type": "string", "minLength": 1},
        "truth_requirement": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "evidence_outcome": {"type": "string", "minLength": 1},
        "matched_manual_event_id": {"type": ["string", "null"]},
        "segment_iou": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "missing_evidence": {"$ref": "#/$defs/stringArray"},
        "affected_indicator_instances": {"$ref": "#/$defs/stringArray"}
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator_instance_id", "event_id", "indicator_id", "linked_work_item_ids", "status", "satisfied_work_item_count", "required_work_item_count"],
      "properties": {
        "indicator_instance_id": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "indicator_id": {"type": "string", "minLength": 1},
        "linked_work_item_ids": {"$ref": "#/$defs/stringArray"},
        "status": {"$ref": "#/$defs/status"},
        "satisfied_work_item_count": {"type": "integer", "minimum": 0},
        "required_work_item_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
