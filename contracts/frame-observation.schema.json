{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/frame-observation.schema.json",
  "title": "RallyMate Stage 1 Frame Observation",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "frame",
    "quality",
    "detections",
    "poses",
    "court",
    "handoff"
  ],
  "properties": {
    "subject_identity": {"type": "object","required": ["version","subject_id","status","source_track_id","evidence","reason_code"],"properties": {"version": {"const": "subject-lock-v1"},"subject_id": {"enum": ["subject-1",null]},"status": {"enum": ["locked","reidentified","unknown"]},"source_track_id": {"type": ["integer","null"],"minimum": 1},"evidence": {"type": "array","items": {"type": "string"}},"reason_code": {"type": ["string","null"]},"appearance_distance": {"type": ["number","null"],"minimum": 0,"maximum": 1}},"allOf": [{"if": {"properties": {"status": {"const": "unknown"}}},"then": {"properties": {"subject_id": {"type": "null"},"source_track_id": {"type": "null"},"reason_code": {"type": "string","minLength": 1}}},"else": {"properties": {"subject_id": {"const": "subject-1"},"source_track_id": {"type": "integer","minimum": 1},"evidence": {"minItems": 1},"reason_code": {"type": "null"}}}}],"description": "Sequence-local target association, not a verified real-world person identity. Unknown frames must not be grouped under legacy primary_player_id=1."},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "job_id": {"type": "string"},
    "frame": {
      "type": "object",
      "required": [
        "index",
        "processed_index",
        "timestamp_ms",
        "width",
        "height",
        "coordinate_origin"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "processed_index": {"type": "integer", "minimum": 0},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "source_timestamp_ms": {"type": "integer", "minimum": 0, "description": "Absolute rounded source PTS; timestamp_ms remains relative playback time."},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "coordinate_origin": {"const": "top_left"}
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "brightness",
        "contrast",
        "blur_score",
        "status",
        "warnings"
      ],
      "properties": {
        "status": {"enum": ["ok", "warning"]},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class_name",
          "confidence",
          "bbox_px",
          "bbox_normalized",
          "center_px",
          "center_normalized",
          "downstream_systems",
          "track_id"
        ],
        "properties": {
          "class_name": {"enum": ["player", "ball", "racket"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "bbox_px": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number", "minimum": 0}
          },
          "bbox_normalized": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "center_px": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number", "minimum": 0}
          },
          "center_normalized": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "downstream_systems": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "track_id": {"type": "integer", "minimum": 1}
        }
      }
    },
    "poses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "person_track_id",
          "confidence",
          "coordinate_space",
          "keypoint_format",
          "keypoints"
        ],
        "properties": {
          "person_track_id": {"type": "integer", "minimum": 1},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "coordinate_space": {"const": "original_frame"},
          "keypoint_format": {"enum": ["coco17", "halpe26", "coco_wholebody133", "mhr70"]},
          "keypoints": {
            "type": "array",
            "minItems": 17,
            "maxItems": 133,
            "items": {
              "type": "object",
              "required": [
                "index",
                "name",
                "downstream_joint_id",
                "x_px",
                "y_px",
                "x_normalized",
                "y_normalized",
                "confidence"
              ],
              "properties": {
                "index": {"type": "integer", "minimum": 0, "maximum": 132},
                "name": {"type": "string"},
                "downstream_joint_id": {
                  "oneOf": [
                    {"type": "string", "pattern": "^J[0-9]{3}$"},
                    {"type": "null"}
                  ]
                },
                "x_px": {"type": "number", "minimum": 0},
                "y_px": {"type": "number", "minimum": 0},
                "x_normalized": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y_normalized": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "confidence": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 1
                },
                "raw_x_px": {"type": "number"},
                "raw_y_px": {"type": "number"},
                "in_frame": {"type": "boolean"},
                "raw_confidence": {"type": "number"},
                "confidence_in_range": {"type": "boolean"}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"keypoint_format": {"const": "mhr70"}}, "required": ["keypoint_format"]},
            "then": {
              "required": ["source", "status", "confidence_semantics", "observation_semantics", "source_binding"],
              "properties": {
                "source": {"const": "sam3d"},
                "status": {"const": "ok"},
                "confidence": {"type": "null"},
                "confidence_semantics": {"const": "not_provided_by_sam3d"},
                "observation_semantics": {"const": "monocular_model_estimate"},
                "source_binding": {"$ref": "#/$defs/sam_source_binding"},
                "keypoints": {
                  "minItems": 70, "maxItems": 70,
                  "items": {
                    "required": ["source", "confidence_semantics", "observation_semantics", "observed", "visibility", "in_frame", "raw_x_px", "raw_y_px"],
                    "properties": {
                      "source": {"const": "sam3d"},
                      "confidence_semantics": {"const": "not_provided_by_sam3d"},
                      "observation_semantics": {"const": "model_estimate"},
                      "confidence": {"type": "null"},
                      "observed": {"type": "null"},
                      "visibility": {"type": "null"},
                      "in_frame": {"type": "boolean"},
                      "raw_x_px": {"type": "number"},
                      "raw_y_px": {"type": "number"}
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "source": {"not": {"const": "sam3d"}},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "keypoints": {"items": {"properties": {"confidence": {"type": "number", "minimum": 0, "maximum": 1}}}}
              }
            }
          }
        ]
      }
    },
    "court": {
      "type": "object",
      "required": [
        "status",
        "method",
        "downstream_system",
        "confidence",
        "region_usable",
        "calibration_usable",
        "polygon_px",
        "polygon_normalized"
      ],
      "properties": {
        "status": {
          "enum": [
            "disabled",
            "absent",
            "uncertain",
            "detected",
            "calibrated"
          ]
        },
        "method": {"type": "string"},
        "downstream_system": {"const": "S05"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "region_usable": {"type": "boolean"},
        "calibration_usable": {"type": "boolean"},
        "polygon_px": {"type": "array"},
        "polygon_normalized": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "pose_player_link",
        "coordinate_space",
        "timebase",
        "downstream_taxonomy"
      ]
    }
  },
  "$defs": {
    "sam_source_binding": {
      "type": "object",
      "required": ["video_sha256", "frame_index", "processed_index", "pts", "time_base_num", "time_base_den", "timestamp_ms", "person_track_id", "selection_epoch", "camera_reference_epoch"],
      "properties": {
        "video_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "frame_index": {"type": "integer", "minimum": 0},
        "processed_index": {"type": "integer", "minimum": 0},
        "pts": {"type": "integer", "minimum": 0},
        "time_base_num": {"type": "integer", "minimum": 1},
        "time_base_den": {"type": "integer", "minimum": 1},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "person_track_id": {"type": "integer", "minimum": 1},
        "selection_epoch": {"type": "integer", "minimum": 0},
        "camera_reference_epoch": {"type": "integer", "minimum": 0}
      }
    }
  }
}
