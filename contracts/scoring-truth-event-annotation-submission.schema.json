{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/scoring-truth-event-annotation-submission.schema.json",
  "title": "RallyMate M93 canonical A/B event/phase annotation submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "submission_version", "status", "artifact_scope", "execution_id",
    "execution_bundle", "authorization_binding_sha256", "submission_id", "role_slot",
    "annotator_id", "videos", "submitted_at", "submission_revision_sha256", "exported_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "submission_version": {"const": "scoring-truth-event-annotation-submission-v1.0.0"},
    "status": {"const": "full_video_event_phase_annotation_submitted"},
    "artifact_scope": {"const": "independent_full_video_event_phase_annotation"},
    "execution_id": {"type": "string", "pattern": "^m93-event-execution-[0-9A-F]{64}$"},
    "execution_bundle": {"$ref": "#/$defs/bundle_ref"},
    "authorization_binding_sha256": {"$ref": "#/$defs/sha256"},
    "submission_id": {"type": "string", "pattern": "^submission-[0-9A-F]{64}$"},
    "role_slot": {"enum": ["A", "B"]},
    "annotator_id": {"$ref": "#/$defs/identifier"},
    "videos": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/video1"}, {"$ref": "#/$defs/video2"}, {"$ref": "#/$defs/video3"}
      ], "items": false
    },
    "submitted_at": {"$ref": "#/$defs/submission_timestamp"},
    "submission_revision_sha256": {"$ref": "#/$defs/sha256"},
    "exported_at": {"$ref": "#/$defs/submission_timestamp"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "submission_timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "bundle_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_id", "manifest_binding_sha256"],
      "properties": {
        "bundle_id": {"type": "string", "pattern": "^m93-event-execution-[AB]-[0-9A-F]{64}$"},
        "manifest_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "full_review": {
      "type": "object", "additionalProperties": false,
      "required": ["completed", "notes", "reviewed_at", "review_revision_sha256"],
      "properties": {
        "completed": {"const": true}, "notes": {"type": "string"},
        "reviewed_at": {"$ref": "#/$defs/submission_timestamp"},
        "review_revision_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "phase_observed": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "timestamp_ms", "reason"],
      "properties": {"status": {"const": "observed"}, "timestamp_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "reason": {"const": ""}}
    },
    "phase_unobservable": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "timestamp_ms", "reason"],
      "properties": {"status": {"const": "unobservable"}, "timestamp_ms": {"const": null}, "reason": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}}
    },
    "phase": {"oneOf": [{"$ref": "#/$defs/phase_observed"}, {"$ref": "#/$defs/phase_unobservable"}]},
    "phases_fs01": {
      "type": "object", "additionalProperties": false,
      "required": ["preload_ms", "takeoff_proxy_ms", "landing_proxy_ms", "redistribution_ms", "initiation_ms"],
      "properties": {
        "preload_ms": {"$ref": "#/$defs/phase"}, "takeoff_proxy_ms": {"$ref": "#/$defs/phase"},
        "landing_proxy_ms": {"$ref": "#/$defs/phase"}, "redistribution_ms": {"$ref": "#/$defs/phase"},
        "initiation_ms": {"$ref": "#/$defs/phase"}
      }
    },
    "phases_fs02": {
      "type": "object", "additionalProperties": false,
      "required": ["direction_conversion_ms", "support_extension_proxy_ms", "lead_foot_motion_onset_proxy_ms", "first_step_slowdown_proxy_ms"],
      "properties": {
        "direction_conversion_ms": {"$ref": "#/$defs/phase"}, "support_extension_proxy_ms": {"$ref": "#/$defs/phase"},
        "lead_foot_motion_onset_proxy_ms": {"$ref": "#/$defs/phase"}, "first_step_slowdown_proxy_ms": {"$ref": "#/$defs/phase"}
      }
    },
    "phases_fs09": {
      "type": "object", "additionalProperties": false,
      "required": ["peak_speed_ms", "deceleration_peak_ms", "restabilization_onset_ms", "stable_control_onset_ms"],
      "properties": {
        "peak_speed_ms": {"$ref": "#/$defs/phase"}, "deceleration_peak_ms": {"$ref": "#/$defs/phase"},
        "restabilization_onset_ms": {"$ref": "#/$defs/phase"}, "stable_control_onset_ms": {"$ref": "#/$defs/phase"}
      }
    },
    "event_base": {
      "type": "object", "additionalProperties": false,
      "required": [
        "annotation_id", "event_id", "event_code", "start_ms", "end_ms", "phase_observations",
        "confidence_milli", "boundary_uncertainty_ms", "notes", "annotated_at", "annotation_revision_sha256"
      ],
      "properties": {
        "annotation_id": {"type": "string", "pattern": "^m93:[AB]:[A-Za-z0-9._:/-]+$"},
        "event_id": {"type": "string", "pattern": "^m93:[AB]:[A-Za-z0-9._:/-]+$"},
        "event_code": {"enum": ["FS01", "FS02", "FS09"]},
        "start_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "end_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "phase_observations": {"type": "object"},
        "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "boundary_uncertainty_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "notes": {"type": "string"},
        "annotated_at": {"$ref": "#/$defs/submission_timestamp"},
        "annotation_revision_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "event_fs01": {"$ref": "#/$defs/event_base", "properties": {"event_code": {"const": "FS01"}, "phase_observations": {"$ref": "#/$defs/phases_fs01"}}},
    "event_fs02": {"$ref": "#/$defs/event_base", "properties": {"event_code": {"const": "FS02"}, "phase_observations": {"$ref": "#/$defs/phases_fs02"}}},
    "event_fs09": {"$ref": "#/$defs/event_base", "properties": {"event_code": {"const": "FS09"}, "phase_observations": {"$ref": "#/$defs/phases_fs09"}}},
    "event": {"oneOf": [{"$ref": "#/$defs/event_fs01"}, {"$ref": "#/$defs/event_fs02"}, {"$ref": "#/$defs/event_fs09"}]},
    "video_base": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "video_id", "full_video_review", "events", "video_revision_sha256"],
      "properties": {
        "task_id": {"type": "string"}, "video_id": {"type": "string"},
        "full_video_review": {"$ref": "#/$defs/full_review"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "video_revision_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "video1": {"$ref": "#/$defs/video_base", "properties": {"task_id": {"const": "m89:3ae77ee3271d67de171585a5c39ddd69:full-video-event-phase"}, "video_id": {"const": "3ae77ee3271d67de171585a5c39ddd69"}}},
    "video2": {"$ref": "#/$defs/video_base", "properties": {"task_id": {"const": "m89:850cb0006b406c7176eeda8d711cd065:full-video-event-phase"}, "video_id": {"const": "850cb0006b406c7176eeda8d711cd065"}}},
    "video3": {"$ref": "#/$defs/video_base", "properties": {"task_id": {"const": "m89:8d7754d0de6d315674013d5b69a0b6ba:full-video-event-phase"}, "video_id": {"const": "8d7754d0de6d315674013d5b69a0b6ba"}}}
  }
}
