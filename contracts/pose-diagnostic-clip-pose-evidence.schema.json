{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/pose-diagnostic-clip-pose-evidence.schema.json",
  "title": "RallyMate adjudicator-only pose diagnostic overlay evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_version", "clip_id", "video_id", "frame_width_px", "frame_height_px", "keypoint_format", "source", "frames", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_version": {"const": "pose-diagnostic-adjudication-overlay-v1.0.0"},
    "clip_id": {"type": "string", "pattern": "^m79-[0-9a-f]{32}-clip-[0-9]{3}$"},
    "video_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "frame_width_px": {"type": "integer", "minimum": 1},
    "frame_height_px": {"type": "integer", "minimum": 1},
    "keypoint_format": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames_observations_sha256", "primary_timeline_sha256"],
      "properties": {
        "frames_observations_sha256": {"$ref": "#/$defs/sha256"},
        "primary_timeline_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_output_is_ground_truth", "loaded_by_blind_review_page", "quality_gate_modified", "grade_generated", "threshold_generated"],
      "properties": {
        "model_output_is_ground_truth": {"const": false},
        "loaded_by_blind_review_page": {"const": false},
        "quality_gate_modified": {"const": false},
        "grade_generated": {"const": false},
        "threshold_generated": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "keypoint": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "string", "minLength": 1},
        {"type": "number"},
        {"type": "number"},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_frame_index", "timestamp_ms", "source_track_id", "pose_present", "pose_confidence", "keypoints"],
      "properties": {
        "source_frame_index": {"type": "integer", "minimum": 0},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "source_track_id": {"type": ["integer", "null"]},
        "pose_present": {"type": "boolean"},
        "pose_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "keypoints": {"type": "array", "items": {"$ref": "#/$defs/keypoint"}}
      }
    }
  }
}
