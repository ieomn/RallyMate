{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/semantic-ground-truth.schema.json",
  "title": "RallyMate adjudicated semantic ground truth",
  "type": "object",
  "required": [
    "schema_version",
    "annotation_id",
    "video_id",
    "event_id",
    "indicator_id",
    "semantic_key",
    "semantic_type",
    "observable",
    "value",
    "null_reason",
    "annotation_confidence",
    "annotator_id",
    "reviewer_id",
    "adjudication_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "annotation_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "indicator_id": {"type": "string", "minLength": 1},
    "semantic_key": {
      "enum": [
        "bilateral_foot_contact_state",
        "left_foot_contact_or_settle",
        "right_foot_contact_or_settle",
        "post_landing_stable_interval",
        "target_direction",
        "support_side",
        "launch_side",
        "launch_foot_contact_state",
        "first_step_contact_or_settle",
        "post_step_direction_interval",
        "inertia_direction",
        "camera_motion_audit",
        "braking_side",
        "braking_foot_touchdown",
        "stable_interval",
        "stable_control_interval"
      ]
    },
    "semantic_type": {
      "enum": ["direction", "side", "timestamp", "interval", "contact_state", "camera_audit"]
    },
    "observable": {"type": "boolean"},
    "value": {
      "type": ["object", "null"],
      "properties": {
        "direction_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "coordinate_frame": {"enum": ["image_plane", "court_plane"]},
        "side": {"enum": ["left", "right", "bilateral"]},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "contact_state": {"enum": ["contact", "airborne", "settled"]},
        "camera_motion_observed": {"type": "boolean"},
        "audit_method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "null_reason": {"type": ["string", "null"]},
    "annotation_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "annotator_id": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "adjudication_status": {"const": "accepted"}
  },
  "allOf": [
    {
      "if": {"properties": {"observable": {"const": true}}},
      "then": {
        "properties": {
          "value": {"type": "object"},
          "null_reason": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "value": {"type": "null"},
          "null_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "observable": {"const": true},
          "semantic_type": {"const": "direction"}
        }
      },
      "then": {"properties": {"value": {"required": ["direction_deg", "coordinate_frame"]}}}
    },
    {
      "if": {
        "properties": {
          "observable": {"const": true},
          "semantic_type": {"const": "side"}
        }
      },
      "then": {"properties": {"value": {"required": ["side"]}}}
    },
    {
      "if": {
        "properties": {
          "observable": {"const": true},
          "semantic_type": {"const": "timestamp"}
        }
      },
      "then": {"properties": {"value": {"required": ["timestamp_ms"]}}}
    },
    {
      "if": {
        "properties": {
          "observable": {"const": true},
          "semantic_type": {"const": "interval"}
        }
      },
      "then": {"properties": {"value": {"required": ["start_ms", "end_ms"]}}}
    },
    {
      "if": {
        "properties": {
          "observable": {"const": true},
          "semantic_type": {"const": "contact_state"}
        }
      },
      "then": {"properties": {"value": {"required": ["contact_state"]}}}
    },
    {
      "if": {
        "properties": {
          "observable": {"const": true},
          "semantic_type": {"const": "camera_audit"}
        }
      },
      "then": {
        "properties": {
          "value": {"required": ["camera_motion_observed", "audit_method"]}
        }
      }
    }
  ],
  "additionalProperties": false
}
