{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/calibration-promotion-lineage.schema.json",
  "title": "RallyMate production calibration promotion lineage",
  "type": "object",
  "required": [
    "schema_version",
    "promotion_id",
    "promotion_version",
    "calibration_version",
    "promoted_at",
    "indicator_id",
    "backend",
    "candidate",
    "prepared_dataset",
    "truth_authorization",
    "fit_protocol",
    "independent_test",
    "independent_test_report",
    "independent_test_protocol",
    "decision",
    "feasibility_registry",
    "maturity_evidence",
    "independent_test_source_replay",
    "promotion_input_snapshots"
  ],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "promotion_id": {"type": "string", "minLength": 1},
    "promotion_version": {"type": "string", "minLength": 1},
    "calibration_version": {"type": "string", "minLength": 1},
    "promoted_at": {"type": "string", "format": "date-time"},
    "indicator_id": {"type": "string", "minLength": 1},
    "backend": {"enum": ["threshold_rule", "ordinal_regression"]},
    "candidate": {"$ref": "#/$defs/versionedHash"},
    "prepared_dataset": {"type": "object"},
    "truth_authorization": {"$ref": "#/$defs/truthAuthorization"},
    "fit_protocol": {"type": "object"},
    "independent_test": {"type": "object"},
    "independent_test_report": {"type": "object"},
    "independent_test_protocol": {"type": "object"},
    "independent_test_source_replay": {"$ref": "#/$defs/sourceReplay"},
    "promotion_input_snapshots": {"$ref": "#/$defs/promotionInputSnapshots"},
    "decision": {"type": "object"},
    "feasibility_registry": {
      "type": "object",
      "required": ["registry_version", "content_sha256", "indicator_id", "indicator_level", "required_events", "required_features"],
      "properties": {
        "registry_version": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "indicator_id": {"type": "string", "minLength": 1},
        "indicator_level": {"const": "F4"},
        "required_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "maturity_evidence": {
      "allOf": [
        {"$ref": "#/$defs/maturityEvidenceBinding"},
        {"properties": {"artifact_scope": {"const": "maturity_evidence"}}}
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "versionedHash": {
      "type": "object",
      "required": ["candidate_id", "candidate_version", "content_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_version": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "truthAuthorization": {
      "type": "object",
      "required": ["binding_version", "status", "canonicalization", "authorization_id", "event_protocol_authorization", "intake", "revision_lineage", "input_files", "binding_sha256"],
      "properties": {
        "binding_version": {"const": "scoring-truth-calibration-authorization-binding-v1.0.0"},
        "status": {"const": "verified_authorized_intake_for_calibration"},
        "canonicalization": {"const": "rallymate-canonical-json-v1"},
        "authorization_id": {"type": "string", "minLength": 1},
        "event_protocol_authorization": {"type": "object"},
        "intake": {"type": "object"},
        "revision_lineage": {"type": "object"},
        "input_files": {"type": "object"},
        "binding_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "maturityEvidenceBinding": {
      "type": "object",
      "required": [
        "bundle_id",
        "bundle_version",
        "artifact_scope",
        "indicator_id",
        "content_sha256",
        "final_transition_sha256",
        "final_registry",
        "canonicalization"
      ],
      "properties": {
        "bundle_id": {"type": "string", "minLength": 1},
        "bundle_version": {"const": "maturity-evidence-bundle-v1"},
        "artifact_scope": {
          "enum": [
            "maturity_evidence",
            "synthetic_test_only_maturity_evidence"
          ]
        },
        "indicator_id": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "final_transition_sha256": {"$ref": "#/$defs/sha256"},
        "final_registry": {
          "type": "object",
          "required": [
            "registry_version",
            "content_sha256",
            "indicator_id",
            "indicator_level"
          ],
          "properties": {
            "registry_version": {"type": "string", "minLength": 1},
            "content_sha256": {"$ref": "#/$defs/sha256"},
            "indicator_id": {"type": "string", "minLength": 1},
            "indicator_level": {"const": "F4"}
          },
          "additionalProperties": false
        },
        "canonicalization": {"const": "rallymate-canonical-json-v1"}
      },
      "additionalProperties": false
    },
    "sourceReplay": {
      "type": "object",
      "required": ["samples", "indicator_requirements"],
      "properties": {
        "samples": {"$ref": "#/$defs/sampleReplaySource"},
        "indicator_requirements": {"$ref": "#/$defs/requirementsReplaySource"}
      },
      "additionalProperties": false
    },
    "sampleReplaySource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source_kind", "canonical_sha256", "source_record_count", "sealed_record_count"],
          "properties": {
            "source_kind": {"const": "in_memory_canonical_json"},
            "canonical_sha256": {"$ref": "#/$defs/sha256"},
            "source_record_count": {"type": "integer", "minimum": 1},
            "sealed_record_count": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source_kind", "source_path", "raw_sha256", "canonical_sha256", "source_record_count", "sealed_record_count"],
          "properties": {
            "source_kind": {"const": "file_bytes"},
            "source_path": {"type": "string", "minLength": 1},
            "raw_sha256": {"$ref": "#/$defs/sha256"},
            "canonical_sha256": {"$ref": "#/$defs/sha256"},
            "source_record_count": {"type": "integer", "minimum": 1},
            "sealed_record_count": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "requirementsReplaySource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source_kind", "canonical_sha256"],
          "properties": {
            "source_kind": {"const": "in_memory_canonical_json"},
            "canonical_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source_kind", "source_path", "raw_sha256", "canonical_sha256"],
          "properties": {
            "source_kind": {"const": "file_bytes"},
            "source_path": {"type": "string", "minLength": 1},
            "raw_sha256": {"$ref": "#/$defs/sha256"},
            "canonical_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      ]
    },
    "promotionInputSnapshots": {
      "type": "object",
      "required": [
        "candidate",
        "independent_test_report",
        "independent_test_protocol",
        "decision",
        "maturity_evidence",
        "registry_lifecycle_authority"
      ],
      "properties": {
        "candidate": {"$ref": "#/$defs/objectInputSnapshot"},
        "independent_test_report": {"$ref": "#/$defs/objectInputSnapshot"},
        "independent_test_protocol": {"$ref": "#/$defs/objectInputSnapshot"},
        "decision": {"$ref": "#/$defs/objectInputSnapshot"},
        "maturity_evidence": {"$ref": "#/$defs/objectInputSnapshot"},
        "registry_lifecycle_authority": {"$ref": "#/$defs/registryLifecycleInputSnapshot"}
      },
      "additionalProperties": false
    },
    "objectInputSnapshot": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source_kind", "canonical_sha256"],
          "properties": {
            "source_kind": {"const": "in_memory_canonical_json"},
            "canonical_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["source_kind", "source_path", "raw_sha256", "canonical_sha256"],
          "properties": {
            "source_kind": {"const": "file_bytes"},
            "source_path": {"type": "string", "minLength": 1},
            "raw_sha256": {"$ref": "#/$defs/sha256"},
            "canonical_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      ]
    },
    "registryLifecycleInputSnapshot": {
      "oneOf": [
        {
          "type": "object",
          "required": ["source_kind", "artifact_canonical_sha256"],
          "properties": {
            "source_kind": {"const": "in_memory_canonical_json"},
            "artifact_canonical_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "source_kind",
            "manifest_path",
            "manifest_raw_sha256",
            "authority_version",
            "authority_slot",
            "artifact_path",
            "artifact_raw_sha256",
            "artifact_canonical_sha256",
            "embedded_version"
          ],
          "properties": {
            "source_kind": {"const": "registry_lifecycle_verified_file_bytes"},
            "manifest_path": {"type": "string", "minLength": 1},
            "manifest_raw_sha256": {"$ref": "#/$defs/sha256"},
            "authority_version": {"type": "string", "minLength": 1},
            "authority_slot": {"const": "roles.runtime_feasibility"},
            "artifact_path": {"type": "string", "minLength": 1},
            "artifact_raw_sha256": {"$ref": "#/$defs/sha256"},
            "artifact_canonical_sha256": {"$ref": "#/$defs/sha256"},
            "embedded_version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
