{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/multivideo-larger-pose-model-extension.schema.json",
  "title": "RallyMate multivideo larger Pose model extension experiment",
  "type": "object",
  "required": ["schema_version", "report_version", "generated_at", "status", "scope", "sources", "candidate", "inference", "baseline_m68", "baseline_m70", "m71_projection", "by_video", "decision", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_version": {"const": "multivideo-larger-pose-model-extension-v1.0.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"const": "experimental_larger_pose_model_extension_regression_free_requires_truth"},
    "scope": {
      "type": "object",
      "required": ["video_count", "video_ids", "indicator_count", "indicator_instances", "target_frame_count"],
      "properties": {
        "video_count": {"const": 3},
        "video_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "indicator_count": {"type": "integer", "minimum": 1},
        "indicator_instances": {"type": "integer", "minimum": 1},
        "target_frame_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "sources": {"type": "object"},
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "registry_version", "model_sha256", "native_keypoint_format", "input_size_hw", "selection_policy"],
      "properties": {
        "candidate_id": {"const": "rtmpose-l-halpe26-384x288"},
        "registry_version": {"type": "string", "minLength": 1},
        "model_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "native_keypoint_format": {"const": "halpe26"},
        "input_size_hw": {"const": [384, 288]},
        "selection_policy": {"const": "required_joint_validity_strict_superset_on_m70_residual_frames"}
      },
      "additionalProperties": false
    },
    "inference": {"type": "object"},
    "baseline_m68": {"type": "object"},
    "baseline_m70": {"type": "object"},
    "m71_projection": {
      "type": "object",
      "required": ["selected_frame_count", "feature_recovered_from_m68", "feature_regressed_from_m68", "feature_vector_complete", "feature_vector_incomplete", "operational_recovered_from_m68", "operational_regressed_from_m68", "operational_measured", "operational_unavailable", "measurement_hard_fail", "non_hard_fail_operational_residual", "additional_feature_recovery_over_m70", "additional_operational_recovery_over_m70", "lost_m70_feature_recovery_count", "lost_m70_operational_recovery_count"],
      "properties": {
        "feature_regressed_from_m68": {"const": 0},
        "operational_regressed_from_m68": {"const": 0},
        "lost_m70_feature_recovery_count": {"const": 0},
        "lost_m70_operational_recovery_count": {"const": 0}
      }
    },
    "by_video": {"type": "array", "minItems": 3, "maxItems": 3},
    "decision": {
      "type": "object",
      "required": ["production_default_changed", "candidate_promoted", "m70_recovered_sets_preserved", "current_three_video_extension_regression_free", "reason_codes", "next_required_evidence"],
      "properties": {
        "production_default_changed": {"const": false},
        "candidate_promoted": {"const": false},
        "m70_recovered_sets_preserved": {"const": true},
        "current_three_video_extension_regression_free": {"const": true}
      }
    },
    "safety": {
      "type": "object",
      "required": ["accuracy_claim", "ground_truth_provided", "production_enabled", "automatic_profile_fallback_enabled", "feature_gate_modified", "measurement_gate_modified", "event_boundaries_modified", "grades_generated", "thresholds_generated", "maturity_promoted", "current_three_video_regression_free_is_not_independent_validation"],
      "properties": {
        "accuracy_claim": {"const": false},
        "ground_truth_provided": {"const": false},
        "production_enabled": {"const": false},
        "automatic_profile_fallback_enabled": {"const": false},
        "feature_gate_modified": {"const": false},
        "measurement_gate_modified": {"const": false},
        "event_boundaries_modified": {"const": false},
        "grades_generated": {"const": false},
        "thresholds_generated": {"const": false},
        "maturity_promoted": {"const": false},
        "current_three_video_regression_free_is_not_independent_validation": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
