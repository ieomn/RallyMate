{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/calibration-independent-test-report.schema.json",
  "title": "RallyMate sealed calibration independent-test report",
  "type": "object",
  "required": ["schema_version", "artifact_scope", "report_version", "status", "approved_for_scoring", "indicator_id", "candidate", "dataset", "protocol", "indicator_requirements", "evaluated_at", "coverage", "metrics", "acceptance", "predictions", "promotion"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0", "1.2.0"]},
    "artifact_scope": {"enum": ["independent_test_report", "synthetic_test_only_independent_test_report"]},
    "report_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed"]},
    "approved_for_scoring": {"const": false},
    "indicator_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "object"},
    "dataset": {"type": "object"},
    "protocol": {"type": "object"},
    "indicator_requirements": {
      "type": "object",
      "required": ["requirements_version", "content_sha256", "registry_version", "registry_content_sha256", "registry_indicator_sha256", "semantic_contract_version", "semantic_contract_sha256"],
      "properties": {
        "requirements_version": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "registry_version": {"type": "string", "minLength": 1},
        "registry_content_sha256": {"$ref": "#/$defs/sha256"},
        "registry_indicator_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_contract_version": {"type": "string", "minLength": 1},
        "semantic_contract_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "evaluated_at": {"type": "string", "format": "date-time"},
    "coverage": {"type": "object"},
    "metrics": {"type": "object"},
    "acceptance": {
      "type": "object",
      "required": ["passed", "checks", "semantics"],
      "properties": {
        "passed": {"type": "boolean"},
        "checks": {"type": "array"},
        "semantics": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "predictions": {"type": "array"},
    "exclusions": {"type": "array"},
    "promotion": {
      "type": "object",
      "required": ["production_asset_created", "registry_F4_promoted", "explicit_human_approval_required"],
      "properties": {
        "production_asset_created": {"const": false},
        "registry_F4_promoted": {"const": false},
        "explicit_human_approval_required": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "groups": {
      "type": "object",
      "required": ["player_id", "session_id", "view_group", "leakage_group_id"],
      "properties": {
        "player_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "view_group": {"type": "string", "minLength": 1},
        "leakage_group_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "candidate_version", "backend", "content_sha256"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_version": {"type": "string", "minLength": 1},
        "backend": {"enum": ["threshold_rule", "ordinal_regression"]},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["dataset_id", "dataset_version", "seal_id", "content_sha256", "record_count", "leakage_groups", "canonicalization"],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "seal_id": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "record_count": {"type": "integer", "minimum": 0},
        "leakage_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canonicalization": {"const": "rallymate-canonical-json-v1"}
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": ["protocol_id", "protocol_version", "content_sha256", "source_sha256", "registered_at"],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "protocol_version": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "registered_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "confusionRow": {
      "type": "object",
      "required": ["E", "D", "C", "B", "A"],
      "properties": {
        "E": {"type": "integer", "minimum": 0},
        "D": {"type": "integer", "minimum": 0},
        "C": {"type": "integer", "minimum": 0},
        "B": {"type": "integer", "minimum": 0},
        "A": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "metricSummary": {
      "type": "object",
      "required": ["record_count", "accuracy", "mean_absolute_grade_error", "bias_grade_steps", "quadratic_weighted_kappa", "confusion_matrix"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "mean_absolute_grade_error": {"type": ["number", "null"], "minimum": 0},
        "bias_grade_steps": {"type": ["number", "null"]},
        "quadratic_weighted_kappa": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
        "confusion_matrix": {
          "type": "object",
          "required": ["E", "D", "C", "B", "A"],
          "properties": {
            "E": {"$ref": "#/$defs/confusionRow"},
            "D": {"$ref": "#/$defs/confusionRow"},
            "C": {"$ref": "#/$defs/confusionRow"},
            "B": {"$ref": "#/$defs/confusionRow"},
            "A": {"$ref": "#/$defs/confusionRow"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["overall", "by_view_group", "by_player", "by_session"],
      "properties": {
        "overall": {"$ref": "#/$defs/metricSummary"},
        "by_view_group": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metricSummary"}},
        "by_player": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metricSummary"}},
        "by_session": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metricSummary"}}
      },
      "additionalProperties": false
    },
    "legacyCoverage": {
      "type": "object",
      "required": ["eligible_record_count", "evaluated_record_count", "valid_rate", "excluded_record_count", "exclusion_reason_counts"],
      "properties": {
        "eligible_record_count": {"type": "integer", "minimum": 0},
        "evaluated_record_count": {"type": "integer", "minimum": 0},
        "valid_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "excluded_record_count": {"type": "integer", "minimum": 0},
        "exclusion_reason_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["sealed_record_count", "evaluation_eligible_record_count", "evaluated_record_count", "valid_rate", "evaluation_eligible_rate", "eligible_evaluation_completion_rate", "excluded_record_count", "exclusion_reason_counts"],
      "properties": {
        "sealed_record_count": {"type": "integer", "minimum": 0},
        "evaluation_eligible_record_count": {"type": "integer", "minimum": 0},
        "evaluated_record_count": {"type": "integer", "minimum": 0},
        "valid_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "evaluation_eligible_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "eligible_evaluation_completion_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "excluded_record_count": {"type": "integer", "minimum": 0},
        "exclusion_reason_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "prediction": {
      "type": "object",
      "required": ["sample_id", "video_id", "event_id", "expected_grade", "predicted_grade", "grade_probabilities", "groups"],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "video_id": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1},
        "expected_grade": {"enum": ["E", "D", "C", "B", "A"]},
        "predicted_grade": {"enum": ["E", "D", "C", "B", "A"]},
        "grade_probabilities": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["E", "D", "C", "B", "A"],
              "properties": {
                "E": {"type": "number", "minimum": 0, "maximum": 1},
                "D": {"type": "number", "minimum": 0, "maximum": 1},
                "C": {"type": "number", "minimum": 0, "maximum": 1},
                "B": {"type": "number", "minimum": 0, "maximum": 1},
                "A": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          ]
        },
        "groups": {"$ref": "#/$defs/groups"}
      },
      "additionalProperties": false
    },
    "legacyExclusion": {
      "type": "object",
      "required": ["sample_id", "reason", "groups"],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "groups": {"$ref": "#/$defs/groups"}
      },
      "additionalProperties": false
    },
    "exclusion": {
      "type": "object",
      "required": ["sample_id", "classification", "reason_codes", "groups"],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "classification": {"const": "not_evaluation_eligible"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "groups": {"$ref": "#/$defs/groups"}
      },
      "additionalProperties": false
    },
    "acceptanceCheck": {
      "type": "object",
      "required": ["metric", "passed", "observed", "required", "source"],
      "properties": {
        "metric": {"enum": ["minimum_record_count", "minimum_leakage_group_count", "minimum_valid_rate", "maximum_mean_absolute_grade_error", "maximum_absolute_bias_grade_steps", "minimum_quadratic_weighted_kappa", "required_grade_coverage", "required_view_groups"]},
        "passed": {"type": "boolean"},
        "observed": {},
        "required": {},
        "source": {"const": "preregistered_protocol_no_internal_default"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.0.0"}}, "required": ["schema_version"]},
      "then": {"properties": {"artifact_scope": {"const": "synthetic_test_only_independent_test_report"}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}, "required": ["schema_version"]},
      "then": {
        "required": ["exclusions"],
        "properties": {
          "candidate": {"$ref": "#/$defs/candidate"},
          "dataset": {"$ref": "#/$defs/dataset"},
          "protocol": {"$ref": "#/$defs/protocol"},
          "coverage": {"$ref": "#/$defs/legacyCoverage"},
          "metrics": {"$ref": "#/$defs/metrics"},
          "acceptance": {
            "type": "object",
            "required": ["passed", "checks", "semantics"],
            "properties": {
              "passed": {"type": "boolean"},
              "checks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/acceptanceCheck"}},
              "semantics": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "predictions": {"type": "array", "items": {"$ref": "#/$defs/prediction"}},
          "exclusions": {"type": "array", "items": {"$ref": "#/$defs/legacyExclusion"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2.0"}}, "required": ["schema_version"]},
      "then": {
        "required": ["exclusions"],
        "properties": {
          "candidate": {"$ref": "#/$defs/candidate"},
          "dataset": {"$ref": "#/$defs/dataset"},
          "protocol": {"$ref": "#/$defs/protocol"},
          "coverage": {"$ref": "#/$defs/coverage"},
          "metrics": {"$ref": "#/$defs/metrics"},
          "acceptance": {
            "type": "object",
            "required": ["passed", "checks", "semantics"],
            "properties": {
              "passed": {"type": "boolean"},
              "checks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/acceptanceCheck"}},
              "semantics": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "predictions": {"type": "array", "items": {"$ref": "#/$defs/prediction"}},
          "exclusions": {"type": "array", "items": {"$ref": "#/$defs/exclusion"}}
        }
      }
    },
    {
      "if": {"properties": {"artifact_scope": {"const": "independent_test_report"}}, "required": ["artifact_scope"]},
      "then": {"properties": {"schema_version": {"const": "1.2.0"}}}
    },
    {
      "if": {
        "properties": {
          "artifact_scope": {"const": "independent_test_report"},
          "status": {"const": "passed"}
        },
        "required": ["artifact_scope", "status"]
      },
      "then": {
        "properties": {
          "dataset": {"properties": {"record_count": {"minimum": 1}}},
          "coverage": {"properties": {"sealed_record_count": {"minimum": 1}, "evaluation_eligible_record_count": {"minimum": 1}, "evaluated_record_count": {"minimum": 1}, "eligible_evaluation_completion_rate": {"const": 1}}},
          "predictions": {"minItems": 1},
          "acceptance": {"properties": {"passed": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2.0"}, "status": {"const": "failed"}}, "required": ["schema_version", "status"]},
      "then": {"properties": {"acceptance": {"properties": {"passed": {"const": false}}}}}
    }
  ],
  "additionalProperties": false
}
