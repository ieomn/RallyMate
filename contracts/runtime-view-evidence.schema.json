{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/runtime-view-evidence.schema.json",
  "title": "RallyMate accepted per-video runtime view evidence",
  "type": "object",
  "required": ["schema_version", "artifact_scope", "evidence_id", "video_id", "video_sha256", "view_profile_id", "view_group", "verification_protocol_version", "satisfied_constraints", "status", "verifier_id", "verified_at", "source_sha256", "canonicalization"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_scope": {"const": "runtime_view_evidence"},
    "evidence_id": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "video_sha256": {"$ref": "#/$defs/sha256"},
    "view_profile_id": {"type": "string", "minLength": 1},
    "view_group": {"type": "string", "minLength": 1},
    "verification_protocol_version": {"type": "string", "minLength": 1},
    "satisfied_constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"const": "accepted"},
    "verifier_id": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string", "format": "date-time"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "canonicalization": {"const": "rallymate-canonical-json-v1"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}},
  "additionalProperties": false
}
