{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/scoring-visual-observer-manifest.schema.json",
  "title": "RallyMate synchronized scoring observer manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observer_version", "title", "videos", "safety", "content_sha256"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "observer_version": {"const": "dynamic-scoring-observer-v1.1.0"},
    "title": {"type": "string", "minLength": 1},
    "videos": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video_id", "display_name", "data_file", "content_sha256", "data_file_sha256", "source_summary_sha256", "frame_count", "duration_ms", "event_count", "indicator_instance_count", "feature_status_counts", "scoring_status_counts"],
        "properties": {
          "video_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
          "display_name": {"type": "string", "minLength": 1},
          "data_file": {"type": "string", "pattern": "^data/[a-f0-9]{32}\\.json$"},
          "content_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
          "data_file_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
          "source_summary_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
          "frame_count": {"type": "integer", "minimum": 1},
          "duration_ms": {"type": "integer", "minimum": 0},
          "event_count": {"type": "integer", "minimum": 1},
          "indicator_instance_count": {"type": "integer", "minimum": 1},
          "feature_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
          "scoring_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy_claim", "formal_scoring_claim", "model_pose_is_ground_truth"],
      "properties": {
        "accuracy_claim": {"const": false},
        "formal_scoring_claim": {"const": false},
        "model_pose_is_ground_truth": {"const": false}
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
