{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/scoring-truth-priority-worklist.schema.json",
  "title": "RallyMate scoring truth priority worklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worklist_version", "generated_at", "status", "source", "counts", "items", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "worklist_version": {"const": "scoring-truth-priority-worklist-v1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "annotation_required"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_id", "scores", "events", "summary", "blocker_audit", "diagnostic_queue", "review_video"],
      "properties": {
        "video_id": {"type": "string", "minLength": 1},
        "scores": {"$ref": "#/$defs/source"},
        "events": {"$ref": "#/$defs/source"},
        "summary": {"$ref": "#/$defs/source"},
        "blocker_audit": {"$ref": "#/$defs/source"},
        "diagnostic_queue": {"$ref": "#/$defs/source"},
        "review_video": {"$ref": "#/$defs/source"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_complete_feature_score_only_indicator_instances", "work_items", "by_flag", "pose_diagnostic_items_linked", "pose_diagnostic_items_missing_queue_task", "accepted_annotations"],
      "properties": {
        "eligible_complete_feature_score_only_indicator_instances": {"type": "integer", "minimum": 1},
        "work_items": {"type": "integer", "minimum": 1},
        "by_flag": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "pose_diagnostic_items_linked": {"type": "integer", "minimum": 0},
        "pose_diagnostic_items_missing_queue_task": {"type": "integer", "minimum": 0},
        "accepted_annotations": {"const": 0}
      }
    },
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_candidates_are_truth", "quality_gate_modified", "grades_generated", "thresholds_generated", "maturity_promoted", "priority_is_accuracy", "clearing_one_item_automatically_changes_score", "maximum_post_review_status_without_calibration"],
      "properties": {
        "model_candidates_are_truth": {"const": false},
        "quality_gate_modified": {"const": false},
        "grades_generated": {"const": false},
        "thresholds_generated": {"const": false},
        "maturity_promoted": {"const": false},
        "priority_is_accuracy": {"const": false},
        "clearing_one_item_automatically_changes_score": {"const": false},
        "maximum_post_review_status_without_calibration": {"const": "calibration_required"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_item_id", "event_id", "event_code", "start_ms", "end_ms", "person_track_id", "diagnostic_flag", "truth_requirement", "review_type", "diagnostic_queue_link_status", "diagnostic_task_ids", "candidate_review_times_ms", "affected_indicator_instances", "affected_indicator_count", "sole_block_indicator_instances", "sole_block_indicator_count", "concurrent_flags", "review_status", "priority_rank"],
      "properties": {
        "work_item_id": {"type": "string", "pattern": "^stpw-[a-f0-9]{16}$"},
        "event_id": {"type": "string", "minLength": 1},
        "event_code": {"enum": ["FS01", "FS02", "FS09"]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0},
        "person_track_id": {"type": "integer", "minimum": 0},
        "diagnostic_flag": {"type": "string", "minLength": 1},
        "truth_requirement": {"type": "string", "minLength": 1},
        "review_type": {"enum": ["pose_diagnostic_queue", "event_or_semantic_truth"]},
        "diagnostic_queue_link_status": {"enum": ["linked", "missing_pose_diagnostic_task", "not_applicable"]},
        "diagnostic_task_ids": {"$ref": "#/$defs/stringArray"},
        "candidate_review_times_ms": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "affected_indicator_instances": {"$ref": "#/$defs/stringArray"},
        "affected_indicator_count": {"type": "integer", "minimum": 1},
        "sole_block_indicator_instances": {"$ref": "#/$defs/stringArray"},
        "sole_block_indicator_count": {"type": "integer", "minimum": 0},
        "concurrent_flags": {"$ref": "#/$defs/stringArray"},
        "review_status": {"const": "annotation_required"},
        "priority_rank": {"type": "integer", "minimum": 1}
      }
    }
  }
}
