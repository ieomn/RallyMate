{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/multivideo-event-bounded-pose-gap-audit.schema.json",
  "title": "RallyMate multivideo event-bounded Pose gap counterfactual",
  "type": "object",
  "required": ["schema_version", "report_version", "generated_at", "status", "scope", "sources", "contract", "residual_scope", "counterfactual_summary", "items", "decision", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_version": {"const": "multivideo-event-bounded-pose-gap-audit-v1.0.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["experimental_bounded_gap_counterfactual_found_recovery_requires_truth", "experimental_bounded_gap_counterfactual_no_indicator_recovery"]},
    "scope": {
      "type": "object",
      "required": ["fixed_camera", "single_primary_player", "pose_topology", "counterfactual_only", "event_boundaries_reused"],
      "properties": {
        "fixed_camera": {"const": true},
        "single_primary_player": {"const": true},
        "pose_topology": {"type": "string", "minLength": 1},
        "counterfactual_only": {"const": true},
        "event_boundaries_reused": {"const": true}
      },
      "additionalProperties": false
    },
    "sources": {"type": "object"},
    "contract": {
      "type": "object",
      "required": ["max_bounding_observation_span_ms", "timebase", "eligible_gap", "coordinate_interpolation", "effective_confidence", "existing_smoothing_contract_alignment"],
      "properties": {
        "max_bounding_observation_span_ms": {"const": 160},
        "timebase": {"const": "timestamp_ms"},
        "eligible_gap": {"type": "string", "minLength": 1},
        "coordinate_interpolation": {"const": "linear_in_timestamp"},
        "effective_confidence": {"type": "string", "minLength": 1},
        "existing_smoothing_contract_alignment": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "residual_scope": {
      "type": "object",
      "required": ["source_milestone", "indicator_instance_count", "classification_counts"],
      "properties": {
        "source_milestone": {"const": "M73"},
        "indicator_instance_count": {"const": 13},
        "classification_counts": {"type": "object"}
      },
      "additionalProperties": false
    },
    "counterfactual_summary": {
      "type": "object",
      "required": ["indicator_replay_interpolated_joint_observation_count", "unique_event_joint_observation_count", "eligible_internal_missing_run_count", "eligible_bounding_observation_span_ms", "missing_run_kind_counts", "feature_transition_counts", "counterfactual_recovered_indicator_instance_count", "counterfactual_remaining_indicator_instance_count", "production_recovered_indicator_instance_count"],
      "properties": {
        "indicator_replay_interpolated_joint_observation_count": {"type": "integer", "minimum": 0},
        "unique_event_joint_observation_count": {"type": "integer", "minimum": 0},
        "eligible_internal_missing_run_count": {"type": "integer", "minimum": 0},
        "eligible_bounding_observation_span_ms": {"type": "object", "required": ["minimum", "maximum"]},
        "missing_run_kind_counts": {"type": "object"},
        "feature_transition_counts": {"type": "object"},
        "counterfactual_recovered_indicator_instance_count": {"type": "integer", "minimum": 0},
        "counterfactual_remaining_indicator_instance_count": {"type": "integer", "minimum": 0},
        "production_recovered_indicator_instance_count": {"const": 0}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": ["video_id", "event_id", "event_code", "start_ms", "end_ms", "indicator_id", "original_classification", "required_features", "invalid_features_before", "joint_scope", "gap_audit", "feature_transitions", "counterfactual_feature_vector_complete", "production_measurement_status"],
        "properties": {
          "video_id": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "event_code": {"enum": ["FS01", "FS02", "FS09"]},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "indicator_id": {"type": "string", "pattern": "^FS[0-9]{2}-M[0-9]{2}$"},
          "original_classification": {"type": "string", "minLength": 1},
          "required_features": {"type": "array", "minItems": 1, "uniqueItems": true},
          "invalid_features_before": {"type": "array", "minItems": 1, "uniqueItems": true},
          "joint_scope": {"type": "array", "minItems": 1, "uniqueItems": true},
          "gap_audit": {"type": "object"},
          "feature_transitions": {"type": "array", "minItems": 1},
          "counterfactual_feature_vector_complete": {"type": "boolean"},
          "production_measurement_status": {"const": "unchanged_unavailable"}
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": ["materialize_production_pose_artifact", "reason", "next_step"],
      "properties": {
        "materialize_production_pose_artifact": {"const": false},
        "reason": {"type": "string", "minLength": 1},
        "next_step": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["accuracy_claim", "ground_truth_provided", "grade_generated", "scoring_threshold_generated", "production_pose_artifact_generated", "production_scoring_allowed", "event_boundary_extrapolation_allowed", "cross_event_interpolation_allowed", "event_phase_creation_allowed", "zero_fill_allowed"],
      "properties": {
        "accuracy_claim": {"const": false},
        "ground_truth_provided": {"const": false},
        "grade_generated": {"const": false},
        "scoring_threshold_generated": {"const": false},
        "production_pose_artifact_generated": {"const": false},
        "production_scoring_allowed": {"const": false},
        "event_boundary_extrapolation_allowed": {"const": false},
        "cross_event_interpolation_allowed": {"const": false},
        "event_phase_creation_allowed": {"const": false},
        "zero_fill_allowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
