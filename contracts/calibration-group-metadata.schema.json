{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/calibration-group-metadata.schema.json",
  "title": "RallyMate calibration grouping metadata",
  "description": "Human/collection metadata used only to prevent player/session leakage. Missing identities block readiness; they are never inferred from track IDs.",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["video_id", "person_track_id", "player_id", "session_id", "view_group"],
        "properties": {
          "video_id": {"type": "string", "minLength": 1},
          "person_track_id": {"type": ["integer", "null"], "minimum": 1},
          "player_id": {"type": ["string", "null"], "minLength": 1},
          "session_id": {"type": ["string", "null"], "minLength": 1},
          "view_group": {"type": ["string", "null"], "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
