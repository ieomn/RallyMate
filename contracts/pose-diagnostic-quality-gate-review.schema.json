{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/pose-diagnostic-quality-gate-review.schema.json",
  "title": "RallyMate Pose diagnostic quality gate evidence review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_version", "generated_at", "status", "quality_policy_version_under_review", "protocol", "sources", "missing_registered_scope_manifest_hashes", "by_diagnostic_type", "blockers", "policy_decision", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_version": {"const": "pose-diagnostic-quality-gate-review-v1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["annotation_and_protocol_required", "acceptance_protocol_required", "registered_scope_incomplete", "annotation_required", "insufficient_evidence", "acceptance_criteria_failed", "eligible_for_human_policy_review"]},
    "quality_policy_version_under_review": {"const": "indicator-event-quality-v1.6.0"},
    "protocol": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/protocolBinding"}]},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "missing_registered_scope_manifest_hashes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "by_diagnostic_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keypoint_jump", "left_right_swap", "primary_identity_ambiguity", "source_track_switch"],
      "properties": {
        "keypoint_jump": {"$ref": "#/$defs/diagnosticReview"},
        "left_right_swap": {"$ref": "#/$defs/diagnosticReview"},
        "primary_identity_ambiguity": {"$ref": "#/$defs/diagnosticReview"},
        "source_track_switch": {"$ref": "#/$defs/diagnosticReview"}
      }
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "policy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic_policy_change_allowed", "quality_policy_change_applied", "next_quality_policy_version", "human_review_required", "semantics"],
      "properties": {
        "automatic_policy_change_allowed": {"const": false},
        "quality_policy_change_applied": {"const": false},
        "next_quality_policy_version": {"type": "null"},
        "human_review_required": {"const": true},
        "semantics": {"type": "string", "minLength": 1}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A_to_E_thresholds_generated", "grades_generated", "quality_gate_modified", "maturity_promoted", "self_declared_protocol_identity_is_trusted"],
      "properties": {
        "A_to_E_thresholds_generated": {"const": false},
        "grades_generated": {"const": false},
        "quality_gate_modified": {"const": false},
        "maturity_promoted": {"const": false},
        "self_declared_protocol_identity_is_trusted": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "protocolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "protocol_version", "path", "sha256", "content_sha256", "registered_at", "registration"],
      "properties": {
        "protocol_id": {"type": "string", "minLength": 1},
        "protocol_version": {"const": "pose-diagnostic-gate-acceptance-protocol-v1.0.0"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "registered_at": {"type": "string", "format": "date-time"},
        "registration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry_id", "source_kind", "source_sha256"],
          "properties": {
            "registry_id": {"type": "string", "minLength": 1},
            "source_kind": {"const": "external_protocol_registry"},
            "source_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_id", "manifest_path", "manifest_file_sha256", "manifest_content_sha256", "evaluation_path", "evaluation_sha256", "evaluation_status", "truth_pack_source_queue_sha256", "queue_artifact_binding_sha256"],
      "properties": {
        "video_id": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_file_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_content_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_path": {"type": "string", "minLength": 1},
        "evaluation_sha256": {"$ref": "#/$defs/sha256"},
        "evaluation_status": {"enum": ["annotation_required", "partial_coverage", "evaluated_full_timeline"]},
        "truth_pack_source_queue_sha256": {"$ref": "#/$defs/sha256"},
        "queue_artifact_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic_type", "require_full_timeline_per_scope", "minimum_evaluated_scopes", "minimum_total_truth_positives", "minimum_precision", "minimum_recall", "minimum_f1"],
      "properties": {
        "diagnostic_type": {"enum": ["keypoint_jump", "left_right_swap", "primary_identity_ambiguity", "source_track_switch"]},
        "require_full_timeline_per_scope": {"const": true},
        "minimum_evaluated_scopes": {"type": "integer", "minimum": 1},
        "minimum_total_truth_positives": {"type": "integer", "minimum": 1},
        "minimum_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_f1": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "criterionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "required", "passed"],
      "properties": {
        "observed": {"type": ["number", "null"]},
        "required": {"type": "number"},
        "passed": {"type": "boolean"}
      }
    },
    "criteriaResults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_timeline_scopes", "truth_positives", "precision", "recall", "f1"],
      "properties": {
        "full_timeline_scopes": {"$ref": "#/$defs/criterionResult"},
        "truth_positives": {"$ref": "#/$defs/criterionResult"},
        "precision": {"$ref": "#/$defs/criterionResult"},
        "recall": {"$ref": "#/$defs/criterionResult"},
        "f1": {"$ref": "#/$defs/criterionResult"}
      }
    },
    "diagnosticReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_scope_count", "full_timeline_scope_count", "true_positive", "false_positive", "false_negative", "truth_positive_count", "precision", "recall", "f1", "criteria", "criteria_results", "status"],
      "properties": {
        "evaluation_scope_count": {"type": "integer", "minimum": 1},
        "full_timeline_scope_count": {"type": "integer", "minimum": 0},
        "true_positive": {"type": "integer", "minimum": 0},
        "false_positive": {"type": "integer", "minimum": 0},
        "false_negative": {"type": "integer", "minimum": 0},
        "truth_positive_count": {"type": "integer", "minimum": 0},
        "precision": {"$ref": "#/$defs/rate"},
        "recall": {"$ref": "#/$defs/rate"},
        "f1": {"$ref": "#/$defs/rate"},
        "criteria": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/criteria"}]},
        "criteria_results": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/criteriaResults"}]},
        "status": {"enum": ["acceptance_protocol_required", "annotation_required", "insufficient_positive_truth", "criteria_passed_pending_human_policy_review", "acceptance_criteria_failed"]}
      }
    }
  }
}
