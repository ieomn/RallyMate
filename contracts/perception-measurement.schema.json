          "status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "observed",
              "model_estimate"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "not": {
              "type": "null"
            }
          },
          "source_frames": {
            "minItems": 1
          }
        }
      }
    }
