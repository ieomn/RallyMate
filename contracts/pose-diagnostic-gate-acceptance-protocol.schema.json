{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/pose-diagnostic-gate-acceptance-protocol.schema.json",
  "title": "RallyMate preregistered Pose diagnostic gate acceptance protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "protocol_id", "artifact_scope", "created_at", "registered_at", "registered_by", "registration", "quality_policy_version_under_review", "evaluation_version", "matching_protocol_version", "diagnostic_types", "expected_scopes", "requirements", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_version": {"const": "pose-diagnostic-gate-acceptance-protocol-v1.0.0"},
    "protocol_id": {"type": "string", "minLength": 1},
    "artifact_scope": {"const": "external_preregistered_diagnostic_gate_protocol"},
    "created_at": {"type": "string", "format": "date-time"},
    "registered_at": {"type": "string", "format": "date-time"},
    "registered_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "role"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "source_kind", "source_sha256"],
      "properties": {
        "registry_id": {"type": "string", "minLength": 1},
        "source_kind": {"const": "external_protocol_registry"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "quality_policy_version_under_review": {"const": "indicator-event-quality-v1.6.0"},
    "evaluation_version": {"const": "pose-diagnostic-evaluation-v1.0.0"},
    "matching_protocol_version": {"const": "exact-source-frame-and-diagnostic-scope-v1"},
    "diagnostic_types": {"const": ["keypoint_jump", "left_right_swap", "primary_identity_ambiguity", "source_track_switch"]},
    "expected_scopes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scope"}
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_all_expected_scopes", "per_diagnostic_type"],
      "properties": {
        "require_all_expected_scopes": {"const": true},
        "per_diagnostic_type": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/criteria"}
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thresholds_are_A_to_E_scoring_thresholds", "automatic_quality_policy_change_allowed", "result_revealed_before_registration"],
      "properties": {
        "thresholds_are_A_to_E_scoring_thresholds": {"const": false},
        "automatic_quality_policy_change_allowed": {"const": false},
        "result_revealed_before_registration": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-Fa-f]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "video_id", "truth_pack_manifest_content_sha256", "truth_pack_source_queue_sha256", "queue_artifact_binding_sha256"],
      "properties": {
        "scope_id": {"type": "string", "minLength": 1},
        "video_id": {"type": "string", "minLength": 1},
        "truth_pack_manifest_content_sha256": {"$ref": "#/$defs/sha256"},
        "truth_pack_source_queue_sha256": {"$ref": "#/$defs/sha256"},
        "queue_artifact_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic_type", "require_full_timeline_per_scope", "minimum_evaluated_scopes", "minimum_total_truth_positives", "minimum_precision", "minimum_recall", "minimum_f1"],
      "properties": {
        "diagnostic_type": {"enum": ["keypoint_jump", "left_right_swap", "primary_identity_ambiguity", "source_track_switch"]},
        "require_full_timeline_per_scope": {"const": true},
        "minimum_evaluated_scopes": {"type": "integer", "minimum": 1},
        "minimum_total_truth_positives": {"type": "integer", "minimum": 1},
        "minimum_precision": {"$ref": "#/$defs/rate"},
        "minimum_recall": {"$ref": "#/$defs/rate"},
        "minimum_f1": {"$ref": "#/$defs/rate"}
      }
    }
  }
}
