{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/larger-pose-model-extension.schema.json",
  "title": "RallyMate per-video larger Pose model extension experiment",
  "type": "object",
  "required": ["schema_version", "report_version", "generated_at", "status", "video_id", "sources", "candidate", "artifacts", "inference", "router_audit", "comparison_to_m68", "m70_preservation", "decision", "safety"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_version": {"const": "larger-pose-model-extension-v1.0.0"},
    "generated_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["experimental_larger_pose_model_extension_regression_free_requires_truth", "experimental_larger_pose_model_extension_rejected"]},
    "video_id": {"type": "string", "minLength": 1},
    "sources": {"type": "object"},
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "registry_version", "checkpoint_url", "input_size_hw", "native_keypoint_format"],
      "properties": {
        "candidate_id": {"const": "rtmpose-l-halpe26-384x288"},
        "registry_version": {"type": "string", "minLength": 1},
        "checkpoint_url": {"type": "string", "minLength": 1},
        "input_size_hw": {"const": [384, 288]},
        "native_keypoint_format": {"const": "halpe26"}
      },
      "additionalProperties": false
    },
    "artifacts": {"type": "object"},
    "inference": {
      "type": "object",
      "required": ["target_frame_count", "pose_output_produced", "pose_output_missing", "frame_results"]
    },
    "router_audit": {
      "type": "object",
      "required": ["target_frame_count", "selected_frame_count", "rejected_frame_count", "selection_uses_feature_values", "selection_uses_event_outcomes", "selection_uses_grades_or_thresholds", "required_joint_validity_regression_allowed"],
      "properties": {
        "selection_uses_feature_values": {"const": false},
        "selection_uses_event_outcomes": {"const": false},
        "selection_uses_grades_or_thresholds": {"const": false},
        "required_joint_validity_regression_allowed": {"const": false}
      }
    },
    "comparison_to_m68": {"type": "object"},
    "m70_preservation": {
      "type": "object",
      "required": ["m70_feature_recovery_count", "extended_feature_recovery_count", "additional_feature_recovery_count", "lost_m70_feature_recovery_count", "m70_operational_recovery_count", "extended_operational_recovery_count", "additional_operational_recovery_count", "lost_m70_operational_recovery_count", "additional_operational_recoveries"],
      "properties": {
        "lost_m70_feature_recovery_count": {"type": "integer", "minimum": 0},
        "lost_m70_operational_recovery_count": {"type": "integer", "minimum": 0}
      }
    },
    "decision": {
      "type": "object",
      "required": ["production_default_changed", "candidate_promoted", "current_video_regression_free", "next_required_evidence"],
      "properties": {
        "production_default_changed": {"const": false},
        "candidate_promoted": {"const": false}
      }
    },
    "safety": {
      "type": "object",
      "required": ["accuracy_claim", "ground_truth_provided", "production_enabled", "automatic_profile_fallback_enabled", "feature_gate_modified", "measurement_gate_modified", "event_boundaries_modified", "grades_generated", "thresholds_generated", "maturity_promoted"],
      "properties": {
        "accuracy_claim": {"const": false},
        "ground_truth_provided": {"const": false},
        "production_enabled": {"const": false},
        "automatic_profile_fallback_enabled": {"const": false},
        "feature_gate_modified": {"const": false},
        "measurement_gate_modified": {"const": false},
        "event_boundaries_modified": {"const": false},
        "grades_generated": {"const": false},
        "thresholds_generated": {"const": false},
        "maturity_promoted": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
