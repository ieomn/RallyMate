{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/feature-observation-gap-audit.schema.json",
  "title": "RallyMate feature observation gap audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_version", "generated_at", "status", "source", "counts", "reason_metrics", "recovery_priority", "indicator_metrics", "profile_alternative_metrics", "event_failures", "assertions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_version": {"const": "feature-observation-gap-audit-v1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"const": "audited_no_measurement_or_scoring_gate_change"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_id", "current_profile", "registry_version", "indicator_features", "features", "events", "summary", "registry", "profile_comparisons"],
      "properties": {
        "video_id": {"type": "string", "minLength": 1},
        "current_profile": {"type": "string", "minLength": 1},
        "registry_version": {"type": "string", "minLength": 1},
        "indicator_features": {"$ref": "#/$defs/sourceFile"},
        "features": {"$ref": "#/$defs/sourceFile"},
        "events": {"$ref": "#/$defs/sourceFile"},
        "summary": {"$ref": "#/$defs/sourceFile"},
        "registry": {"$ref": "#/$defs/sourceFile"},
        "profile_comparisons": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/comparisonSource"}}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_count", "indicator_record_count", "feature_measured_indicator_count", "feature_unavailable_indicator_count", "affected_event_count", "invalid_required_feature_occurrence_count", "unique_invalid_event_feature_count", "grade_count", "threshold_count"],
      "properties": {
        "event_count": {"type": "integer", "minimum": 1},
        "indicator_record_count": {"type": "integer", "minimum": 1},
        "feature_measured_indicator_count": {"type": "integer", "minimum": 0},
        "feature_unavailable_indicator_count": {"type": "integer", "minimum": 0},
        "affected_event_count": {"type": "integer", "minimum": 0},
        "invalid_required_feature_occurrence_count": {"type": "integer", "minimum": 0},
        "unique_invalid_event_feature_count": {"type": "integer", "minimum": 0},
        "grade_count": {"const": 0},
        "threshold_count": {"const": 0}
      }
    },
    "reason_metrics": {"type": "array", "items": {"$ref": "#/$defs/reasonMetric"}},
    "recovery_priority": {"type": "array", "items": {"$ref": "#/$defs/reasonMetric"}},
    "indicator_metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/indicatorMetric"}
    },
    "profile_alternative_metrics": {"type": "array", "items": {"$ref": "#/$defs/profileMetric"}},
    "event_failures": {"type": "array", "items": {"$ref": "#/$defs/eventFailure"}},
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_feature_contract_matches_registry", "compact_features_match_full_features", "profile_comparisons_use_identical_candidate_boundaries", "measurement_gate_modified", "scoring_gate_modified", "automatic_profile_fallback_enabled", "cross_model_counts_are_accuracy_metrics", "human_ground_truth_still_required", "grade_generated", "threshold_generated", "maturity_promoted"],
      "properties": {
        "required_feature_contract_matches_registry": {"const": true},
        "compact_features_match_full_features": {"const": true},
        "profile_comparisons_use_identical_candidate_boundaries": {"const": true},
        "measurement_gate_modified": {"const": false},
        "scoring_gate_modified": {"const": false},
        "automatic_profile_fallback_enabled": {"const": false},
        "cross_model_counts_are_accuracy_metrics": {"const": false},
        "human_ground_truth_still_required": {"const": true},
        "grade_generated": {"const": false},
        "threshold_generated": {"const": false},
        "maturity_promoted": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "sourceFile": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "comparisonSource": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "current_profile", "alternative_profile", "boundary_source_sha256", "semantics"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"},
        "current_profile": {"type": "string", "minLength": 1}, "alternative_profile": {"type": "string", "minLength": 1},
        "boundary_source_sha256": {"$ref": "#/$defs/sha256"},
        "semantics": {"const": "same_candidate_boundary_observability_only_not_accuracy_or_truth"}
      }
    },
    "reasonMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["reason", "recovery_class", "required_action", "unique_event_feature_count", "affected_indicator_instance_count", "affected_event_count", "automatic_recovery_allowed"],
      "properties": {
        "reason": {"type": "string", "minLength": 1}, "recovery_class": {"type": "string", "minLength": 1}, "required_action": {"type": "string", "minLength": 1},
        "unique_event_feature_count": {"type": "integer", "minimum": 1}, "affected_indicator_instance_count": {"type": "integer", "minimum": 1}, "affected_event_count": {"type": "integer", "minimum": 1},
        "automatic_recovery_allowed": {"const": false}
      }
    },
    "indicatorMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["indicator_instance_count", "measured_count", "unavailable_count", "invalid_required_feature_occurrence_count"],
      "properties": {
        "indicator_instance_count": {"type": "integer", "minimum": 1}, "measured_count": {"type": "integer", "minimum": 0}, "unavailable_count": {"type": "integer", "minimum": 0}, "invalid_required_feature_occurrence_count": {"type": "integer", "minimum": 0}
      }
    },
    "instanceRef": {
      "type": "object", "additionalProperties": false, "required": ["event_id", "indicator_id"],
      "properties": {"event_id": {"type": "string", "minLength": 1}, "indicator_id": {"type": "string", "minLength": 1}}
    },
    "profileMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["alternative_profile", "current_unavailable_alternative_measured_count", "current_measured_alternative_unavailable_count", "current_unavailable_alternative_measured_instances", "current_measured_alternative_unavailable_instances", "automatic_profile_fallback_allowed", "accuracy_claim"],
      "properties": {
        "alternative_profile": {"type": "string", "minLength": 1},
        "current_unavailable_alternative_measured_count": {"type": "integer", "minimum": 0}, "current_measured_alternative_unavailable_count": {"type": "integer", "minimum": 0},
        "current_unavailable_alternative_measured_instances": {"type": "array", "items": {"$ref": "#/$defs/instanceRef"}},
        "current_measured_alternative_unavailable_instances": {"type": "array", "items": {"$ref": "#/$defs/instanceRef"}},
        "automatic_profile_fallback_allowed": {"const": false}, "accuracy_claim": {"const": false}
      }
    },
    "invalidFeatureRef": {
      "type": "object", "additionalProperties": false, "required": ["feature_name", "reason"],
      "properties": {"feature_name": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}
    },
    "indicatorFailure": {
      "type": "object", "additionalProperties": false,
      "required": ["indicator_id", "invalid_required_features", "quality_gate_status", "hard_fail", "scoring_block_flags", "alternative_profile_measurement_status"],
      "properties": {
        "indicator_id": {"type": "string", "minLength": 1}, "invalid_required_features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invalidFeatureRef"}},
        "quality_gate_status": {"type": "string", "minLength": 1}, "hard_fail": {"type": "boolean"}, "scoring_block_flags": {"type": "array", "items": {"type": "string"}},
        "alternative_profile_measurement_status": {"type": "object", "additionalProperties": {"enum": ["measured", "unavailable"]}}
      }
    },
    "rawCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["series_sample_count", "finite_sample_count", "null_sample_count", "observed_source_frame_count", "start_ms", "end_ms"],
      "properties": {
        "series_sample_count": {"type": "integer", "minimum": 0}, "finite_sample_count": {"type": "integer", "minimum": 0}, "null_sample_count": {"type": "integer", "minimum": 0}, "observed_source_frame_count": {"type": "integer", "minimum": 0},
        "start_ms": {"type": ["integer", "null"]}, "end_ms": {"type": ["integer", "null"]}
      }
    },
    "diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["valid_fraction", "required_joints_used", "measurement_status", "raw_observation_counts", "feature_summary"],
      "properties": {
        "valid_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "required_joints_used": {"type": "array", "items": {"type": "string"}}, "measurement_status": {"type": ["string", "null"]},
        "raw_observation_counts": {"$ref": "#/$defs/rawCounts"}, "feature_summary": {"type": "object"}
      }
    },
    "invalidFeature": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_name", "feature_version", "unit", "reason", "confidence", "source_frames", "affected_indicator_ids", "recovery_class", "required_action", "diagnostics"],
      "properties": {
        "feature_name": {"type": "string", "minLength": 1}, "feature_version": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "source_frames": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "affected_indicator_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "recovery_class": {"type": "string", "minLength": 1}, "required_action": {"type": "string", "minLength": 1}, "diagnostics": {"$ref": "#/$defs/diagnostics"}
      }
    },
    "eventFailure": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "event_code", "person_track_id", "start_ms", "end_ms", "video_seek_seconds", "indicator_failures", "invalid_features"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1}, "event_code": {"type": "string", "minLength": 1}, "person_track_id": {"type": "integer", "minimum": 1},
        "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 0}, "video_seek_seconds": {"type": "number", "minimum": 0},
        "indicator_failures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/indicatorFailure"}}, "invalid_features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/invalidFeature"}}
      }
    }
  }
}
