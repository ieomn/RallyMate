{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/metric-feasibility.schema.json",
  "type": "object",
  "required": ["schema_version", "registry_version", "updated_at", "scope", "level_definitions", "indicators"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_version": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "object"},
    "level_definitions": {
      "type": "object",
      "required": ["F0", "F1", "F2", "F3", "F4"]
    },
    "indicators": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["indicator_id", "feasibility_level", "required_events", "required_features", "view_constraints", "ground_truth_requirements", "current_blockers", "acceptance_metrics", "versions"],
        "properties": {
          "indicator_id": {"type": "string", "pattern": "^FS(01|02|09)-M[0-9]{2}$"},
          "feasibility_level": {"enum": ["F0", "F1", "F2", "F3", "F4"]},
          "required_events": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_features": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "view_constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "ground_truth_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "current_blockers": {"type": "array", "items": {"type": "string"}},
          "acceptance_metrics": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
          "versions": {"type": "object"}
        }
      }
    }
  }
}
