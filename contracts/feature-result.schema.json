{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/feature-result.schema.json",
  "type": "object",
  "required": ["feature_name", "feature_version", "value", "unit", "confidence", "valid", "reason", "source_frames", "raw_value", "smoothed_value", "provenance"],
  "properties": {
    "feature_name": {"type": "string"},
    "feature_version": {"type": "string"},
    "value": {"type": ["number", "integer", "array", "object", "null"]},
    "unit": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "valid": {"type": "boolean"},
    "reason": {"type": "string"},
    "source_frames": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "raw_value": {},
    "smoothed_value": {},
    "provenance": {"type": "object"}
  }
}
