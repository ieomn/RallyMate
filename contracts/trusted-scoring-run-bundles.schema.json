{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/trusted-scoring-run-bundles.schema.json",
  "title": "RallyMate operator-controlled scoring run-bundle allow-list",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_scope",
    "ledger_id",
    "ledger_version",
    "source",
    "registered_at",
    "canonicalization",
    "entries",
    "trust_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_scope": {"const": "trusted_scoring_run_bundles"},
    "ledger_id": {"type": "string", "minLength": 1},
    "ledger_version": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["kind", "authority_id"],
      "properties": {
        "kind": {"const": "operator_controlled_local_ledger"},
        "authority_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "registered_at": {"type": "string", "format": "date-time"},
    "canonicalization": {"const": "rallymate-canonical-json-v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "description": "Runtime validation additionally requires unique entry_id values, unique active bundle roots, and at most one active entry per video_id; replace an authorized run by revoking its prior entry.",
      "items": {"$ref": "#/$defs/entry"}
    },
    "trust_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "artifact_sha256": {
      "type": "object",
      "required": [
        "events_jsonl",
        "features_jsonl",
        "indicator_features_jsonl",
        "scores_jsonl",
        "event_feature_errors_json"
      ],
      "properties": {
        "events_jsonl": {"$ref": "#/$defs/sha256"},
        "features_jsonl": {"$ref": "#/$defs/sha256"},
        "indicator_features_jsonl": {"$ref": "#/$defs/sha256"},
        "scores_jsonl": {"$ref": "#/$defs/sha256"},
        "event_feature_errors_json": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "artifact_sha256_v2": {
      "type": "object",
      "required": ["events_jsonl", "features_jsonl", "indicator_features_jsonl", "scores_jsonl", "event_feature_errors_json"],
      "properties": {
        "events_jsonl": {"$ref": "#/$defs/sha256"},
        "features_jsonl": {"$ref": "#/$defs/sha256"},
        "indicator_features_jsonl": {"$ref": "#/$defs/sha256"},
        "scores_jsonl": {"$ref": "#/$defs/sha256"},
        "event_feature_errors_json": {"$ref": "#/$defs/sha256"},
        "source_aligned_measurements_json": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "evidence_storage": {
      "type": "object",
      "required": ["codec", "path", "sha256", "binding_sha256", "video_id", "source_id", "video_sha256"],
      "properties": {
        "codec": {"const": "scoring-artifact-evidence-v1"},
        "path": {"const": "scoring-evidence.sqlite3"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "binding_sha256": {"$ref": "#/$defs/sha256"},
        "video_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "video_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false,
      "description": "The immutable evidence pool is part of the v2 bundle identity. Runtime validation also checks its file/content hashes and matching video/source bindings."
    },
    "bundle_identity": {
      "type": "object",
      "required": [
        "binding_version",
        "scoring_summary",
        "video",
        "artifact_sha256"
      ],
      "properties": {
        "binding_version": {"enum": ["scoring-run-bundle-v1", "scoring-run-bundle-v2"]},
        "scoring_summary": {
          "type": "object",
          "required": ["schema_version", "loop_version", "file_sha256"],
          "properties": {
            "schema_version": {"const": "1.0.0"},
            "loop_version": {"type": "string", "minLength": 1},
            "file_sha256": {
              "allOf": [{"$ref": "#/$defs/sha256"}],
              "description": "SHA-256 of the exact scoring-loop-summary.json file bytes, not its canonical JSON projection"
            }
          },
          "additionalProperties": false
        },
        "video": {
          "type": "object",
          "required": ["video_id", "video_sha256"],
          "properties": {
            "video_id": {"type": "string", "minLength": 1},
            "video_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "artifact_sha256": {"type": "object"},
        "evidence_storage": {"$ref": "#/$defs/evidence_storage"}
      },
      "allOf": [
        {
          "if": {"properties": {"binding_version": {"const": "scoring-run-bundle-v1"}}},
          "then": {
            "not": {"required": ["evidence_storage"]},
            "properties": {"artifact_sha256": {"$ref": "#/$defs/artifact_sha256"}}
          },
          "else": {
            "required": ["evidence_storage"],
            "properties": {"artifact_sha256": {"$ref": "#/$defs/artifact_sha256_v2"}}
          }
        }
      ],
      "additionalProperties": false
    },
    "authorization_review": {
      "type": "object",
      "required": [
        "decision",
        "review_id",
        "reviewer_id",
        "source_sha256",
        "reviewed_at"
      ],
      "properties": {
        "decision": {"const": "approved_for_production_rescoring"},
        "review_id": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "entry_id",
        "status",
        "bundle_identity",
        "bundle_root_sha256",
        "authorization_review",
        "registered_at"
      ],
      "properties": {
        "entry_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "revoked"]},
        "bundle_identity": {"$ref": "#/$defs/bundle_identity"},
        "bundle_root_sha256": {"$ref": "#/$defs/sha256"},
        "authorization_review": {"$ref": "#/$defs/authorization_review"},
        "registered_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
