{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/request.schema.json",
  "title": "RallyMate Vision Stage 1 Request",
  "type": "object",
  "required": ["schema_version", "job_id", "source", "output", "models"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "job_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["video_path"],
      "properties": {
        "video_path": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "required": ["directory"],
      "properties": {
        "directory": {"type": "string", "minLength": 1}
      }
    },
    "models": {
      "type": "object",
      "required": ["detect", "pose"],
      "properties": {
        "detect": {"type": "string", "minLength": 1},
        "pose": {"type": "string", "minLength": 1},
        "device": {"type": "string", "default": "auto"},
        "detect_imgsz": {"type": "integer", "minimum": 320, "default": 960},
        "pose_imgsz": {"type": "integer", "minimum": 320, "default": 640},
        "detect_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.15
        },
        "pose_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.25
        },
        "pose_backend": {"enum": ["yolo", "rtmpose"], "default": "yolo"},
        "pose_runtime": {"enum": ["pytorch", "onnxruntime", "tensorrt"], "default": "pytorch"},
        "pose_profile": {"enum": ["realtime", "analysis"], "default": "realtime"},
        "pose_config": {"type": ["string", "null"]},
        "pose_preset": {
          "type": ["string", "null"],
          "enum": ["yolo-baseline", "rtmpose-m-halpe26-online", "rtmpose-m-halpe26-analysis", "rtmpose-l-halpe26-analysis-shadow", "rtmpose-m-wholebody133-analysis", null]
        },
        "pose_native_keypoint_format": {
          "type": ["string", "null"],
          "enum": ["coco17", "halpe26", "coco_wholebody133", null]
        }
      }
    },
    "processing": {
      "type": "object",
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0, "default": 0},
        "end_ms": {"type": ["integer", "null"], "minimum": 1},
        "frame_stride": {"type": "integer", "minimum": 1, "default": 1},
        "max_frames": {"type": ["integer", "null"], "minimum": 1},
        "max_players": {"type": "integer", "minimum": 1, "default": 2},
        "court_every_n_frames": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        },
        "write_annotated_video": {"type": "boolean", "default": true}
      }
    },
    "court": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["auto", "manual", "disabled"],
          "default": "auto"
        },
        "manual_polygon_normalized": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "manual_polygon_role": {
          "enum": [
            "visible_region",
            "court_outer_doubles_corners"
          ],
          "default": "visible_region"
        },
        "refresh_policy": {
          "enum": ["once", "until_usable", "interval"],
          "default": "until_usable"
        }
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "feasibility_registry": {"type": "string", "minLength": 1},
        "reference_context": {"type": "string", "minLength": 1},
        "calibration_assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "default": []
        }
      },
      "additionalProperties": false
    },
    "upstream_metadata": {"type": "object"}
  }
}
