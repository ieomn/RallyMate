{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/indicator-feature.schema.json",
  "type": "object",
  "required": ["schema_version", "video_id", "indicator_id", "feasibility_level", "event_id", "event_code", "person_track_id", "feature_status", "features", "scoring_status", "grade", "reason_codes", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "video_id": {"type": "string", "minLength": 1},
    "indicator_id": {"type": "string", "pattern": "^(GS|FS)[0-9]{2}-M[0-9]{2}(-[0-9]{2})?$"},
    "feasibility_level": {"enum": ["F0", "F1", "F2", "F3", "F4"]},
    "event_id": {"type": "string", "minLength": 1},
    "event_code": {"type": "string", "pattern": "^(GS|FS)[0-9]{2}$"},
    "person_track_id": {"type": "integer", "minimum": 1},
    "feature_status": {"enum": ["measured", "unavailable"]},
    "features": {"type": "array", "minItems": 1},
    "scoring_feature_status": {"enum": ["measured", "unavailable"]},
    "scoring_features": {"type": "array", "minItems": 1},
    "supplemental_features": {"type": "array"},
    "supplemental_feature_status": {"enum": ["measured", "unavailable", "not_applicable"]},
    "quality_gate": {"type": "object"},
    "scoring_context": {"type": "object"},
    "scoring_status": {"enum": ["scored", "calibration_required", "unavailable"]},
    "grade": {"type": ["string", "null"], "enum": ["A", "B", "C", "D", "E", null]},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object"}
  }
}
