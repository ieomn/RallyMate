{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/f2-error-budget-readiness.schema.json",
  "title": "RallyMate F2 error-budget readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_version",
    "generated_at",
    "status",
    "registry",
    "sources",
    "counts",
    "indicators",
    "source_fingerprint_sha256",
    "safety"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_version": {"const": "f2-error-budget-readiness-v1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ground_truth_required", "error_budget_and_external_grade_gap_incomplete"]},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "registry_version", "indicator_count", "required_pose_feature_count", "excluded_context_features"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "registry_version": {"type": "string", "minLength": 1},
        "indicator_count": {"type": "integer", "minimum": 1},
        "required_pose_feature_count": {"type": "integer", "minimum": 1},
        "excluded_context_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoothing_coverage", "calculation_coverage", "manual_truth", "truth_evaluations"],
      "properties": {
        "smoothing_coverage": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "required": ["report_version"], "properties": {"report_version": {"type": "string", "minLength": 1}}}]},
        "calculation_coverage": {"allOf": [{"$ref": "#/$defs/artifact"}, {"type": "object", "required": ["coverage_id"], "properties": {"coverage_id": {"type": "string", "minLength": 1}}}]},
        "manual_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manual_events", "manual_keypoints", "manual_semantics"],
          "properties": {
            "manual_events": {"$ref": "#/$defs/truthArtifact"},
            "manual_keypoints": {"$ref": "#/$defs/truthArtifact"},
            "manual_semantics": {"$ref": "#/$defs/truthArtifact"}
          }
        },
        "truth_evaluations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/truthEvaluation"}}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "videos", "indicators", "required_pose_features",
        "smoothing_fully_reconstructable_features", "smoothing_partially_reconstructable_features", "smoothing_not_reconstructable_features",
        "smoothing_computed_records", "smoothing_valid_numeric_records", "smoothing_counterfactual_coverage",
        "indicators_with_complete_smoothing_counterfactual", "indicators_with_partial_smoothing_counterfactual",
        "indicators_with_event_error_evaluation", "indicators_with_feature_error_evaluation", "indicators_with_pose_error_evaluation",
        "indicators_with_event_boundary_error_evaluation", "indicators_with_truth_conditioned_smoothing_error",
        "indicators_with_missing_value_error_impact", "indicators_with_grade_gap_assessment",
        "indicators_ready_for_f2_to_f3", "manual_event_records", "manual_keypoint_records", "manual_semantic_records"
      ],
      "properties": {
        "videos": {"type": "integer", "minimum": 1},
        "indicators": {"type": "integer", "minimum": 1},
        "required_pose_features": {"type": "integer", "minimum": 1},
        "smoothing_fully_reconstructable_features": {"type": "integer", "minimum": 0},
        "smoothing_partially_reconstructable_features": {"type": "integer", "minimum": 0},
        "smoothing_not_reconstructable_features": {"type": "integer", "minimum": 0},
        "smoothing_computed_records": {"type": "integer", "minimum": 0},
        "smoothing_valid_numeric_records": {"type": "integer", "minimum": 0},
        "smoothing_counterfactual_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "indicators_with_complete_smoothing_counterfactual": {"type": "integer", "minimum": 0},
        "indicators_with_partial_smoothing_counterfactual": {"type": "integer", "minimum": 0},
        "indicators_with_event_error_evaluation": {"type": "integer", "minimum": 0},
        "indicators_with_feature_error_evaluation": {"type": "integer", "minimum": 0},
        "indicators_with_pose_error_evaluation": {"type": "integer", "minimum": 0},
        "indicators_with_event_boundary_error_evaluation": {"type": "integer", "minimum": 0},
        "indicators_with_truth_conditioned_smoothing_error": {"type": "integer", "minimum": 0},
        "indicators_with_missing_value_error_impact": {"type": "integer", "minimum": 0},
        "indicators_with_grade_gap_assessment": {"type": "integer", "minimum": 0},
        "indicators_ready_for_f2_to_f3": {"const": 0},
        "manual_event_records": {"type": "integer", "minimum": 0},
        "manual_keypoint_records": {"type": "integer", "minimum": 0},
        "manual_semantic_records": {"type": "integer", "minimum": 0}
      }
    },
    "indicators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/indicator"}},
    "source_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_inference_executed", "existing_pose_frames_reused", "candidate_events_are_ground_truth",
        "smoothing_counterfactual_is_accuracy", "measurement_coverage_is_accuracy", "event_accuracy_claim", "feature_accuracy_claim",
        "grade_gap_claim", "formal_score_claim", "grades_generated", "thresholds_generated", "automatic_f2_to_f3_promotion", "maximum_maturity_claim"
      ],
      "properties": {
        "gpu_inference_executed": {"const": false},
        "existing_pose_frames_reused": {"const": true},
        "candidate_events_are_ground_truth": {"const": false},
        "smoothing_counterfactual_is_accuracy": {"const": false},
        "measurement_coverage_is_accuracy": {"const": false},
        "event_accuracy_claim": {"const": false},
        "feature_accuracy_claim": {"const": false},
        "grade_gap_claim": {"const": false},
        "formal_score_claim": {"const": false},
        "grades_generated": {"const": false},
        "thresholds_generated": {"const": false},
        "automatic_f2_to_f3_promotion": {"const": false},
        "maximum_maturity_claim": {"const": "F2"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "truthArtifact": {
      "allOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "object", "required": ["record_count"], "properties": {"record_count": {"type": "integer", "minimum": 0}}}
      ]
    },
    "nullableMetric": {"type": ["number", "null"]},
    "truthInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "truthEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video_id", "status", "event_evaluation_status", "feature_evaluation_status", "evaluated_feature_names", "pose_error_feature_names", "event_boundary_error_feature_names", "smoothing_error_feature_names", "missing_value_impact_feature_names", "event_f1", "mean_segment_iou", "boundary_mae_ms", "feature_truth_complete", "context_feature_truth_complete", "inputs"],
      "properties": {
        "video_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "event_evaluation_status": {"type": "string", "minLength": 1},
        "feature_evaluation_status": {"type": "string", "minLength": 1},
        "evaluated_feature_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "pose_error_feature_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "event_boundary_error_feature_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "smoothing_error_feature_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_value_impact_feature_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "event_f1": {"$ref": "#/$defs/nullableMetric"},
        "mean_segment_iou": {"$ref": "#/$defs/nullableMetric"},
        "boundary_mae_ms": {"$ref": "#/$defs/nullableMetric"},
        "feature_truth_complete": {"type": "boolean"},
        "context_feature_truth_complete": {"type": "boolean"},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frames", "primary_timeline", "predicted_events"],
          "properties": {
            "frames": {"$ref": "#/$defs/truthInput"},
            "primary_timeline": {"$ref": "#/$defs/truthInput"},
            "predicted_events": {"$ref": "#/$defs/truthInput"}
          }
        }
      }
    },
    "featureCounterfactual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_name", "status", "computed_counterfactual_count", "valid_numeric_record_count", "counterfactual_coverage", "p95_absolute_difference"],
      "properties": {
        "feature_name": {"type": "string", "minLength": 1},
        "status": {"enum": ["fully_reconstructable", "partially_reconstructable", "not_reconstructable"]},
        "computed_counterfactual_count": {"type": "integer", "minimum": 0},
        "valid_numeric_record_count": {"type": "integer", "minimum": 0},
        "counterfactual_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "p95_absolute_difference": {"type": ["number", "null"]}
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicator_id", "feasibility_level", "required_events", "required_pose_features", "required_context_features", "calculation", "smoothing_counterfactual", "event_error", "feature_error", "pose_error", "event_boundary_error", "truth_conditioned_smoothing_error", "missing_value_error_impact", "grade_gap_assessment", "f2_to_f3_ready", "blockers"],
      "properties": {
        "indicator_id": {"type": "string", "pattern": "^(GS|FS)[0-9]{2}-M[0-9]{2}(-[0-9]{2})?$"},
        "feasibility_level": {"const": "F2"},
        "required_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_pose_features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_context_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "calculation": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "candidate_instances", "measured_feature_vectors", "unavailable_feature_vectors", "measurement_rate"],
          "properties": {
            "status": {"enum": ["measured_in_every_video", "incomplete"]},
            "candidate_instances": {"type": "integer", "minimum": 0},
            "measured_feature_vectors": {"type": "integer", "minimum": 0},
            "unavailable_feature_vectors": {"type": "integer", "minimum": 0},
            "measurement_rate": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "smoothing_counterfactual": {
          "type": "object", "additionalProperties": false, "required": ["status", "features"],
          "properties": {
            "status": {"enum": ["complete", "partial", "unavailable"]},
            "features": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/featureCounterfactual"}}
          }
        },
        "event_error": {"$ref": "#/$defs/component"},
        "feature_error": {"$ref": "#/$defs/component"},
        "pose_error": {"$ref": "#/$defs/component"},
        "event_boundary_error": {"$ref": "#/$defs/component"},
        "truth_conditioned_smoothing_error": {"$ref": "#/$defs/component"},
        "missing_value_error_impact": {"$ref": "#/$defs/component"},
        "grade_gap_assessment": {"$ref": "#/$defs/component"},
        "f2_to_f3_ready": {"const": false},
        "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {"status": {"type": "string", "minLength": 1}}
    }
  }
}
