{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/calibration-split-policy.schema.json",
  "title": "RallyMate preregistered calibration split policy",
  "description": "Explicit group assignments only. This contract contains no sample-count, grade-count or agreement acceptance thresholds.",
  "type": "object",
  "required": ["schema_version", "policy_id", "policy_version", "assignments"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["split"],
        "properties": {
          "split": {"enum": ["train", "validation", "independent_test"]},
          "video_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "player_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "session_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "view_groups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "leakage_group_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "anyOf": [
          {"required": ["video_ids"]},
          {"required": ["player_ids"]},
          {"required": ["session_ids"]},
          {"required": ["view_groups"]},
          {"required": ["leakage_group_ids"]}
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
