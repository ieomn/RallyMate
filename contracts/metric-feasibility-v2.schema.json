{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/metric-feasibility-v2.schema.json",
  "title": "RallyMate extensible metric feasibility registry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_version",
    "updated_at",
    "scope",
    "level_definitions",
    "indicators"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "registry_version": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object",
      "required": ["events", "indicator_count"],
      "properties": {
        "events": {"$ref": "#/$defs/non_empty_string_array"},
        "indicator_count": {"type": "integer", "minimum": 1}
      }
    },
    "level_definitions": {
      "type": "object",
      "required": ["F0", "F1", "F2", "F3", "F4"],
      "properties": {
        "F0": {"type": "string", "minLength": 1},
        "F1": {"type": "string", "minLength": 1},
        "F2": {"type": "string", "minLength": 1},
        "F3": {"type": "string", "minLength": 1},
        "F4": {"type": "string", "minLength": 1}
      }
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/indicator"}
    }
  },
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "indicator": {
      "type": "object",
      "required": [
        "indicator_id",
        "feasibility_level",
        "required_events",
        "required_features",
        "view_constraints",
        "ground_truth_requirements",
        "current_blockers",
        "acceptance_metrics",
        "versions"
      ],
      "properties": {
        "indicator_id": {"type": "string", "minLength": 1},
        "feasibility_level": {"enum": ["F0", "F1", "F2", "F3", "F4"]},
        "required_events": {"$ref": "#/$defs/non_empty_string_array"},
        "required_features": {"$ref": "#/$defs/non_empty_string_array"},
        "measurement_features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "view_constraints": {"$ref": "#/$defs/non_empty_string_array"},
        "ground_truth_requirements": {"$ref": "#/$defs/non_empty_string_array"},
        "current_blockers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "feature_availability": {
          "type": "object",
          "required": ["implemented", "missing", "assessment_basis"],
          "properties": {
            "implemented": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "missing": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "assessment_basis": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "acceptance_metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": ["number", "null"]}
        },
        "versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
