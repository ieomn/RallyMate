{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rallymate.local/contracts/score-result.schema.json",
  "type": "object",
  "required": ["schema_version", "status", "grade", "confidence", "feature", "threshold_version", "model_versions", "evidence", "reason_codes", "feedback"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["scored", "calibration_required", "unavailable"]},
    "grade": {"type": ["string", "null"], "enum": ["A", "B", "C", "D", "E", null]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "feature": {"type": "object"},
    "threshold_version": {"type": ["string", "null"]},
    "model_versions": {"type": "object"},
    "evidence": {"type": "array"},
    "scoring_context": {"type": "object"},
    "reason_codes": {"type": "array", "items": {"type": "string"}},
    "feedback": {"type": "string"}
  }
}
