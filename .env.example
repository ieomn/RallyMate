# Local API/worker configuration. Export these values in the process environment.
# Linux production Compose uses deploy/.env.example and deploy/prepare_env.py.
RALLYMATE_ENVIRONMENT=development
RALLYMATE_MODEL_LICENSE_ACK=development
RALLYMATE_DATA_ROOT=./service_data
# Empty DATABASE_URL keeps the existing SQLite jobs database.
DATABASE_URL=
JWT_SECRET=
JWT_SESSION_DAYS=7
PUBLIC_ORIGIN=http://localhost:3000
AUTH_COOKIE_SECURE=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
RALLYMATE_API_KEY=
RALLYMATE_MAX_UPLOAD_BYTES=2147483648
# Keep your current pose backend/model/device settings when adding these variables.
# Metrics are disabled until a random token of at least 32 characters is supplied.
METRICS_TOKEN=
METRICS_TOKEN_FILE=
RALLYMATE_WORKER_METRICS_HOST=127.0.0.1
RALLYMATE_WORKER_METRICS_PORT=0
# Optional. With no DSN, no error reporting is initialized.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
