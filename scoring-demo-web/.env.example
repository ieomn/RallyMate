# Browser-safe settings only. Leave empty to use the same-origin gateway.
NEXT_PUBLIC_RALLYMATE_API_URL=

# Vite dev proxy settings. Also set these in ignored .dev.vars for Worker advice.
RALLYMATE_API_ORIGIN=http://127.0.0.1:8000
RALLYMATE_API_KEY=

# Worker runtime variables belong in .dev.vars locally / Secrets online.
# MIMO_ADVICE_ENABLED=0
# MIMO_API_KEY, MIMO_PROVIDER=openai, MIMO_MODEL=mimo-v2.5-pro
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Only a pay-as-you-go API key may be used. Token Plan keys/endpoints are rejected.
# Do not enable public paid advice until the quota/session rollout in
# ../deploy/autodl/MIMO_PROXY_PLAN.md is complete.
# Website access does not require a username or password.
# For a Node server behind cloudflared with a loopback API: RALLYMATE_LOCAL_TUNNEL=1
