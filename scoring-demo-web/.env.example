# Browser-safe settings only. Leave empty to use the same-origin gateway.
NEXT_PUBLIC_RALLYMATE_API_URL=

# Vite dev proxy settings. Also set these in ignored .dev.vars for Worker advice.
# The web tier never holds RALLYMATE_API_KEY; operators send it directly to /health/ready.
RALLYMATE_API_ORIGIN=http://127.0.0.1:8000

# Worker runtime variables belong in .dev.vars locally / Secrets online.
# MIMO_ADVICE_ENABLED=0
# MIMO_API_KEY, MIMO_PROVIDER=openai, MIMO_MODEL=mimo-v2.6-pro
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Only a pay-as-you-go API key may be used. Token Plan keys/endpoints are rejected.
# Do not enable public paid advice until the quota/session rollout in
# ../deploy/autodl/MIMO_PROXY_PLAN.md is complete.
# Website access uses approved accounts and same-origin session cookies.
# For a Node server behind cloudflared with a loopback API: RALLYMATE_LOCAL_TUNNEL=1

# Optional browser error monitoring. These VITE values are public build settings.
# Empty DSN disables the SDK. Never put API keys or Sentry auth tokens here.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05

# Optional Vinext Node server monitoring (npm run start preload, runtime settings).
SENTRY_FRONTEND_DSN=
SENTRY_FRONTEND_ENVIRONMENT=production
SENTRY_FRONTEND_RELEASE=
SENTRY_FRONTEND_TRACES_SAMPLE_RATE=0.05
