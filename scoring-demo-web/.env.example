# Leave empty for same-origin local routes.
NEXT_PUBLIC_RALLYMATE_API_URL=
NEXT_PUBLIC_RALLYMATE_SCORECARD_PATH=/api/scorecard
NEXT_PUBLIC_RALLYMATE_JOBS_PATH=/v1/jobs
NEXT_PUBLIC_RALLYMATE_TECHNIQUES_PATH=/v1/techniques

# Vite hosts may use the equivalent VITE_* names instead.
# VITE_RALLYMATE_API_URL=
# VITE_RALLYMATE_SCORECARD_PATH=/api/scorecard
# VITE_RALLYMATE_JOBS_PATH=/v1/jobs
# VITE_RALLYMATE_TECHNIQUES_PATH=/v1/techniques

# Vite dev-server proxy target for the local Python API. Production deployments
# should set VITE_RALLYMATE_API_URL (or NEXT_PUBLIC_RALLYMATE_API_URL) instead.
RALLYMATE_API_PROXY=http://127.0.0.1:8000
