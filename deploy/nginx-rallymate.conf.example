# Mounted as the official nginx image's default.conf.template.
# The edge owns forwarded identity; API and Node have no published host ports.
# This file is included in the http{} context, so the next line covers both servers.
server_tokens off;
log_format rallymate '$remote_addr $request_method $uri $status $body_bytes_sent $request_time';
upstream rallymate_api { server api:8000; keepalive 16; }
upstream rallymate_web { server frontend:3000; keepalive 16; }

server {
    listen 80;
    server_name ${PUBLIC_HOST};
    return 308 https://${PUBLIC_HOST}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($host != '${PUBLIC_HOST}') { return 444; }
    access_log /var/log/nginx/access.log rallymate;

    # Security headers. nginx inherits add_header / proxy_hide_header from the
    # enclosing level ONLY when the inner level defines none of its own, so no
    # location below may use add_header or proxy_hide_header; extend this list
    # here instead. Upstream copies are hidden so each header is sent exactly once.
    # The app never frames itself, hence DENY.
    proxy_hide_header Strict-Transport-Security;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Request bodies are small by default; only the upload routes below are large.
    client_max_body_size 1m;
    client_body_timeout 3600s;
    send_timeout 3600s;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-CSRF-Token $http_x_csrf_token;
    proxy_set_header X-Request-ID $http_x_request_id;

    location ~ ^/(?:internal|metrics)(?:/|$) { return 404; }

    # Single-request multipart upload; the API enforces RALLYMATE_MAX_UPLOAD_BYTES.
    location = /v1/jobs {
        client_max_body_size 2G;
        proxy_pass http://rallymate_api;
    }

    # All other API routes, including POST /v1/uploads, GET/DELETE
    # /v1/uploads/{id} and POST /v1/uploads/{id}/complete (small bodies).
    location ^~ /v1/ {
        proxy_pass http://rallymate_api;

        # Resumable upload chunks: the API caps each PUT at 4 MiB (CHUNK_BYTES).
        location ~ ^/v1/uploads/[^/]+/chunks/[0-9]+$ {
            client_max_body_size 5m;
            proxy_pass http://rallymate_api;
        }
    }

    location ^~ /api/auth/ { proxy_pass http://rallymate_api; }
    location ^~ /api/admin/ { proxy_pass http://rallymate_api; }
    location = /api/records { proxy_pass http://rallymate_api; }
    location = /health/live { proxy_pass http://rallymate_api; }
    # Operators supply their maintenance Bearer; user credentials are never replaced.
    location = /health/ready { proxy_pass http://rallymate_api; }

    # Node frontend (/api/scorecard, /api/advice JSON); routes enforce their own caps.
    location / {
        client_max_body_size 16m;
        proxy_pass http://rallymate_web;
    }
}
