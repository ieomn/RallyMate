# Shell-compatible assignments. Copy to runtime.env and chmod 600 runtime.env.
# This file has no real credentials. Keep the API key on the server only.
RALLYMATE_API_KEY='REPLACE_WITH_A_RANDOM_KEY_AT_LEAST_32_CHARACTERS'
RALLYMATE_ENVIRONMENT=development
RALLYMATE_MODEL_LICENSE_ACK=development
RALLYMATE_DEVICE=0
RALLYMATE_CPU_THREADS=4
RALLYMATE_POSE_PRESET=rtmpose-m-halpe26-online
RALLYMATE_DATA_ROOT=/root/autodl-tmp/rallymate/service_data
RALLYMATE_API_ORIGIN=http://127.0.0.1:8001
RALLYMATE_LOCAL_TUNNEL=1
# No RALLYMATE_WEB_USER / RALLYMATE_WEB_PASSWORD: the website opens directly.
# Public links remain relative, so a new Quick Tunnel hostname works immediately.
# Evidence explanations work with the paid language-model integration disabled.
MIMO_ADVICE_ENABLED=0
# Use only an official pay-as-you-go API key; never commit it.
# MIMO_API_KEY=''
# MIMO_PROVIDER=openai
# MIMO_MODEL=mimo-v2.5-pro
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Public paid advice requires the safeguards planned in MIMO_PROXY_PLAN.md.
