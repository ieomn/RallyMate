# Copy to runtime.env only after verifying the model checkpoints and smoke test.
# API key remains server-side; use the same random key for API and web proxy.
RALLYMATE_API_KEY='REPLACE_WITH_A_RANDOM_KEY_AT_LEAST_32_CHARACTERS'
RALLYMATE_ENVIRONMENT=development
RALLYMATE_MODEL_LICENSE_ACK=development
RALLYMATE_DEVICE=0
RALLYMATE_CPU_THREADS=4
RALLYMATE_POSE_BACKEND=sam3d
RALLYMATE_POSE_RUNTIME=pytorch
RALLYMATE_POSE_PROFILE=analysis
RALLYMATE_POSE_NATIVE_KEYPOINT_FORMAT=mhr70
RALLYMATE_POSE_MODEL=/root/autodl-tmp/rallymate/runtime/sam3d/checkpoints/sam-3d-body-dinov3/model.ckpt
RALLYMATE_POSE_CONFIG=/root/autodl-tmp/rallymate/runtime/sam3d/checkpoints/sam-3d-body-dinov3/model_config.yaml
RALLYMATE_SAM3D_RUNTIME=/root/autodl-tmp/rallymate/runtime/sam3d
RALLYMATE_SAM3D_MODE=body
# Optional: run SAM in a separate persistent Python process.
# RALLYMATE_SAM3D_PYTHON=/root/autodl-tmp/rallymate/.venv/bin/python
RALLYMATE_DATA_ROOT=/root/autodl-tmp/rallymate/service_data
RALLYMATE_API_ORIGIN=http://127.0.0.1:8001
RALLYMATE_LOCAL_TUNNEL=1
# Public usage of a new paid provider has not been authorized.
MIMO_ADVICE_ENABLED=0
