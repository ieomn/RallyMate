# Add these non-secret settings to deploy/.env when using the monitoring overlay.
METRICS_TOKEN_FILE=./secrets/metrics_token
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password
GRAFANA_ADMIN_USER=admin
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
UPTIME_KUMA_PORT=3002
# Keep the checked-in local-only receiver until a real recipient is configured.
ALERTMANAGER_CONFIG_DIR=./monitoring/alertmanager
ALERTMANAGER_CONFIG_FILE=alertmanager.yml
