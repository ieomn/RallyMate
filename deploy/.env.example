# Copy to a private .env (chmod 600). Never print a rendered Compose config.
# Set all blank credentials before using: docker compose --env-file .env config --quiet
PUBLIC_HOST=app.example.com
RALLYMATE_TLS_DIR=/etc/rallymate/tls
RALLYMATE_ENVIRONMENT=production
RALLYMATE_MODEL_LICENSE_ACK=
POSTGRES_DB=rallymate
POSTGRES_USER=rallymate
POSTGRES_PASSWORD=
# Use the same database/password above; URL-encode credentials or generate URL-safe passwords.
DATABASE_URL=
JWT_SECRET=
RALLYMATE_API_KEY=
# Optional, initial administrator. Remove both after bootstrap if desired.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# File contains a random METRICS_TOKEN of at least 32 characters; do not log it.
# Keep its parent directory private. Compose mounts this file read-only.
METRICS_TOKEN_FILE=./secrets/metrics_token

RALLYMATE_API_IMAGE=rallymate-api:local
RALLYMATE_FRONTEND_IMAGE=rallymate-frontend:local
# Build the RTMPose image explicitly from deploy/Dockerfile; Compose never rebuilds this tag.
RALLYMATE_WORKER_IMAGE=rallymate-worker-rtmpose:local
RALLYMATE_GPU_DEVICE_ID=0
RALLYMATE_GPU_STATE_DIR=/var/lib/rallymate/gpu-state
RALLYMATE_BACKEND_SUBNET=172.29.71.0/24
RALLYMATE_BACKEND_IP_RANGE=172.29.71.128/25
RALLYMATE_NGINX_IP=172.29.71.2
# Paths are relative to deploy/docker-compose.yml unless absolute.
RALLYMATE_DATA_DIR=../service_data
RALLYMATE_MODELS_DIR=../models
RALLYMATE_CALIBRATION_DIR=../calibration
RALLYMATE_SAM3D_RUNTIME_DIR=../runtime/sam3d
RALLYMATE_SAM3D_CACHE_DIR=../service_data/sam3d-cache
RALLYMATE_MAX_UPLOAD_BYTES=2147483648
RALLYMATE_TECHNIQUE_REGISTRY=
RALLYMATE_CPU_THREADS=4
RALLYMATE_POSE_PRESET=rtmpose-m-halpe26-online
# SAM requires an independently verified SAM worker image and read-only runtime/model mounts.
# For SAM explicitly clear RALLYMATE_POSE_PRESET, then configure backend=sam3d,
# profile=analysis, native format=mhr70, and the mounted model.ckpt/model_config.yaml paths.
RALLYMATE_POSE_BACKEND=rtmpose
RALLYMATE_POSE_PROFILE=realtime
RALLYMATE_POSE_NATIVE_KEYPOINT_FORMAT=halpe26
RALLYMATE_POSE_MODEL=/app/models/rtmpose/rtmpose-m_halpe26_256x192.pth
RALLYMATE_POSE_CONFIG=
RALLYMATE_SAM3D_MODE=body
RALLYMATE_SAM3D_PYTHON=

RALLYMATE_SCORING_REGISTRY_LIFECYCLE_MANIFEST=/app/registry-lifecycle.json
RALLYMATE_SCORING_FEASIBILITY_REGISTRY=/app/metric-feasibility-pose-wave-v3.json
RALLYMATE_SCORING_CALIBRATION_ASSETS=
RALLYMATE_SCORING_TRUSTED_PROMOTION_LEDGER=/app/calibration/trusted-calibration-promotion-ledger.json
RALLYMATE_SCORING_TRUSTED_RUNTIME_PROFILE_BINDINGS=/app/calibration/trusted-runtime-profile-bindings.json
RALLYMATE_SCORING_RUNTIME_VIEW_EVIDENCE_DIR=/app/calibration/runtime-view-evidence

MIMO_ADVICE_ENABLED=0
MIMO_API_KEY=
MIMO_PROVIDER=openai
MIMO_MODEL=mimo-v2.6-pro
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# No DSN means no Sentry initialization or outbound reporting.
SENTRY_DSN=
SENTRY_FRONTEND_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_FRONTEND_ENVIRONMENT=
SENTRY_FRONTEND_RELEASE=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_FRONTEND_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
