# development 可直接做内部验证；商业生产必须改为 enterprise、
# agpl-compliant 或 alternative-backend，并完成相应法律审查。
RALLYMATE_ENVIRONMENT=development
RALLYMATE_MODEL_LICENSE_ACK=development
RALLYMATE_API_KEY=replace-with-a-long-random-token
RALLYMATE_PORT=8000
RALLYMATE_MAX_UPLOAD_BYTES=2147483648
# F2 Pose measurement defaults to the 26-point RTMPose profile. Roll back with
# RALLYMATE_POSE_PRESET=yolo-baseline; this does not enable A-E grading.
RALLYMATE_POSE_PRESET=rtmpose-m-halpe26-online
# 生产评分注册表只能由 lifecycle manifest 的 runtime_feasibility 角色授权；
# 两个路径均应位于运维只读镜像层或只读挂载，不得由 job request 选择。
RALLYMATE_SCORING_REGISTRY_LIFECYCLE_MANIFEST=/app/registry-lifecycle.json
RALLYMATE_SCORING_FEASIBILITY_REGISTRY=/app/metric-feasibility-pose-wave-v2.json
# 当前仓库没有生产标定资产，保持为空。启用时填写容器内只读资产路径；
# 可信账本必须由运维发布，不能放在 /app/service_data 下。
RALLYMATE_SCORING_CALIBRATION_ASSETS=
RALLYMATE_SCORING_TRUSTED_PROMOTION_LEDGER=/app/calibration/trusted-calibration-promotion-ledger.json
# 正式评分还必须配置精确运行 Profile allow-list，以及按视频 SHA-256
# 命名的已接受机位证据目录；三者均为运维侧只读挂载。
RALLYMATE_SCORING_TRUSTED_RUNTIME_PROFILE_BINDINGS=/app/calibration/trusted-runtime-profile-bindings.json
RALLYMATE_SCORING_RUNTIME_VIEW_EVIDENCE_DIR=/app/calibration/runtime-view-evidence
